{
  "schema_version": 1,
  "name": "xkeyboard-config",
  "reference": {
    "blfs_section": "xkeyboard-config",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup --prefix=/usr --buildtype=release .."
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "build",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "ninja test"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install"
        }
      ]
    }
  ],
  "description": "XKeyboardConfig provides the X Window System keyboard configuration database.",
  "dependencies": {
    "build": [
      "xorg-libraries"
    ],
    "runtime": [],
    "test": [],
    "before": [],
    "recommended": [],
    "optional": [
      "libxkbcommon",
      "pytest",
      "Xorg Applications"
    ]
  },
  "installed": {
    "programs": [],
    "libraries": [],
    "directories": [
      "/usr/share/X11/xkb"
    ]
  }
}
