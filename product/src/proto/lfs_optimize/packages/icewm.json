{
  "schema_version": 1,
  "name": "icewm",
  "reference": {
    "blfs_section": "icewm",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build &&\ncd build &&\n\ncmake -D CMAKE_INSTALL_PREFIX=/usr \\\n      -D CMAKE_BUILD_TYPE=Release  \\\n      -D CFGDIR=/etc               \\\n      -D ENABLE_LTO=ON             \\\n      -D DOCDIR=/usr/share/doc/icewm-{version} \\\n      .."
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        },
        {
          "user": "root",
          "command": "rm -v /usr/share/xsessions/icewm.desktop"
        }
      ]
    }
  ],
  "description": "IceWM is a lightweight X11 window manager focused on speed and simplicity.",
  "dependencies": {
    "build": [
      "CMake",
      "imlib2",
      "graphical environment"
    ],
    "runtime": [
      "graphical environment"
    ],
    "test": [
      "No working test suite"
    ],
    "before": [],
    "recommended": [],
    "optional": [
      "asciidoc",
      "FriBidi",
      "librsvg",
      "libao",
      "libsndfile",
      "alsa-lib",
      "gdk-pixbuf-xlib"
    ]
  },
  "integration": {
    "session": {
      "command": "icewm-session",
      "xinitrc": "echo icewm-session > ~/.xinitrc"
    },
    "graphical_environment": {
      "required": true,
      "display_protocol": "X11"
    }
  },
  "installed": {
    "programs": [
      "icehelp",
      "icesh",
      "icesound",
      "icewm",
      "icewm-menu-fdo",
      "icewm-menu-xrandr",
      "icewm-session",
      "icewm-set-gnomewm",
      "icewmbg",
      "icewmhint"
    ],
    "libraries": [],
    "directories": [
      "/usr/share/doc/icewm-{version}",
      "/usr/share/icewm"
    ]
  }
}
