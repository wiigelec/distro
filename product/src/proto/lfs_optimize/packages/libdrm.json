{
  "schema_version": 1,
  "name": "libdrm",
  "reference": {
    "blfs_section": "libdrm",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup --prefix=/usr --buildtype=release -D udev=true -D valgrind=disabled .."
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "build",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "ninja test"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install && /sbin/ldconfig"
        }
      ]
    }
  ],
  "description": "Libdrm provides the userspace Direct Rendering Manager interface used by the Xorg modesetting driver.",
  "dependencies": {
    "build": [
      "systemd"
    ],
    "runtime": [
      "systemd"
    ],
    "test": [],
    "before": [
      "xorg-server"
    ],
    "recommended": [
      "xorg-libraries"
    ],
    "optional": []
  },
  "installed": {
    "programs": [],
    "libraries": [
      "libdrm.so",
      "libdrm_amdgpu.so",
      "libdrm_intel.so",
      "libdrm_nouveau.so",
      "libdrm_radeon.so"
    ],
    "directories": [
      "/usr/include/libdrm",
      "/usr/share/libdrm"
    ]
  }
}
