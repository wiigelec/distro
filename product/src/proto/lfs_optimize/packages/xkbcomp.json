{
  "schema_version": 1,
  "name": "xkbcomp",
  "reference": {
    "blfs_section": "x7app",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "xkbcomp compiles XKB keyboard descriptions for Xorg and Xvfb runtime keyboard initialization.",
  "dependencies": {
    "build": [
      "xorg-libraries"
    ],
    "runtime": [
      "xkeyboard-config"
    ],
    "test": [],
    "before": [
      "xorg-server"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "xkbcomp"
    ],
    "libraries": [],
    "directories": []
  }
}
