{
  "schema_version": 1,
  "name": "libXdmcp",
  "reference": {
    "blfs_section": "libXdmcp",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir='${datadir}'/doc/libXdmcp-{version}"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "source",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "make check"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "libXdmcp implements X Display Manager Control Protocol support.",
  "dependencies": {
    "build": [
      "xorgproto"
    ],
    "runtime": [],
    "test": [],
    "before": [
      "libxcb"
    ],
    "recommended": [],
    "optional": [
      "xmlto",
      "fop",
      "libxslt",
      "xorg-sgml-doctools"
    ]
  },
  "installed": {
    "programs": [],
    "libraries": [
      "libXdmcp.so"
    ],
    "directories": [
      "/usr/share/doc/libXdmcp-{version}"
    ]
  }
}
