{
  "schema_version": 1,
  "name": "coreutils",
  "reference": {
    "lfs_section": "ch-system-coreutils"
  },
  "procedure": [
    {
      "phase": "prepare",
      "resource": "i18n",
      "commands": [
        "patch -Np1 -i ../coreutils-{version}-i18n-1.patch"
      ]
    },
    {
      "phase": "configure",
      "commands": [
        "autoreconf -fv",
        "automake -af",
        "FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=/usr"
      ]
    },
    {
      "phase": "build",
      "commands": [
        "make"
      ]
    },
    {
      "phase": "test",
      "commands": [
        "make NON_ROOT_USERNAME=tester check-root",
        "groupadd -g 102 dummy -U tester",
        "chown -R tester .",
        "su tester -c \"PATH=$PATH make -k RUN_EXPENSIVE_TESTS=yes check\" < /dev/null",
        "groupdel dummy"
      ]
    },
    {
      "phase": "install",
      "commands": [
        "make install",
        "mv -v /usr/bin/chroot /usr/sbin",
        "mv -v /usr/share/man/man1/chroot.1 /usr/share/man/man8/chroot.8",
        "sed -i 's/\"1\"/\"8\"/' /usr/share/man/man8/chroot.8"
      ]
    }
  ],
  "test_expectations": [
    "test-regex-el is known to fail"
  ],
