{
  "schema_version": 1,
  "name": "xinit",
  "reference": {
    "blfs_section": "xinit",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --with-xinitdir=/etc/X11/app-defaults"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install && /sbin/ldconfig"
        }
      ]
    }
  ],
  "description": "xinit provides startx and xinit for starting an X server and client session.",
  "dependencies": {
    "build": [
      "xorg-libraries"
    ],
    "runtime": [
      "xorg-server"
    ],
    "test": [],
    "before": [],
    "recommended": [],
    "optional": [
      "twm",
      "xclock",
      "xterm"
    ]
  },
  "installed": {
    "programs": [
      "startx",
      "xinit"
    ],
    "libraries": [],
    "directories": []
  }
}
