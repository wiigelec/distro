{
  "schema_version": 1,
  "name": "libndp",
  "reference": {
    "blfs_section": "libndp",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr        \\\n            --sysconfdir=/etc    \\\n            --localstatedir=/var \\\n            --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "libndp provides a wrapper for IPv6 Neighbor Discovery Protocol and the ndptool utility.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [
      "No test suite available"
    ],
    "before": [
      "NetworkManager"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "ndptool"
    ],
    "libraries": [
      "libndp.so"
    ],
    "directories": []
  }
}
