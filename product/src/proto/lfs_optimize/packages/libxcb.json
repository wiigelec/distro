{
  "schema_version": 1,
  "name": "libxcb",
  "reference": {
    "blfs_section": "libxcb",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --without-doxygen --docdir='${datadir}'/doc/libxcb-{version}"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "LC_ALL=en_US.UTF-8 make"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "source",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "make check"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        },
        {
          "user": "root",
          "command": "chown -Rv root:root /usr/share/doc/libxcb-{version}"
        }
      ]
    }
  ],
  "description": "libxcb provides the X protocol transport used by Xlib and other X clients.",
  "dependencies": {
    "build": [
      "libXau",
      "xcb-proto"
    ],
    "runtime": [],
    "test": [],
    "before": [
      "xorg-libraries"
    ],
    "recommended": [
      "libXdmcp"
    ],
    "optional": [
      "doxygen",
      "libxslt"
    ]
  },
  "installed": {
    "programs": [],
    "libraries": [
      "libxcb.so"
    ],
    "directories": [
      "/usr/include/xcb",
      "/usr/share/doc/libxcb-{version}"
    ]
  }
}
