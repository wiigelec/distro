{
  "schema_version": 1,
  "name": "xcb-proto",
  "reference": {
    "blfs_section": "xcb-proto",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "PYTHON=python3 ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "source",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "make check"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "xcb-proto provides XML protocol descriptions used to generate libxcb.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "libxcb"
    ],
    "recommended": [],
    "optional": [
      "libxml2"
    ]
  },
  "installed": {
    "programs": [],
    "libraries": [],
    "directories": [
      "/usr/share/xcb",
      "/usr/lib/python3.14/site-packages/xcbgen"
    ]
  }
}
