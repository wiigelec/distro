{
  "schema_version": 1,
  "name": "tcl",
  "reference": {
    "lfs_section": "ch-system-tcl"
  },
  "procedure": [
    {
      "phase": "configure",
      "commands": [
        {
          "command": "SRCDIR=$(pwd)\ncd unix\n./configure --prefix=/usr           \\\n            --mandir=/usr/share/man \\\n            --disable-rpath",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    },
    {
      "phase": "build",
      "commands": [
        {
          "command": "make\n\nsed -e \"s|$SRCDIR/unix|/usr/lib|\" \\\n    -e \"s|$SRCDIR|/usr/include|\"  \\\n    -i tclConfig.sh\n\nsed -e \"s|$SRCDIR/unix/pkgs/tdbc1.1.13|/usr/lib/tdbc1.1.13|\" \\\n    -e \"s|$SRCDIR/pkgs/tdbc1.1.13/generic|/usr/include|\"     \\\n    -e \"s|$SRCDIR/pkgs/tdbc1.1.13/library|/usr/lib/tcl8.6|\"  \\\n    -e \"s|$SRCDIR/pkgs/tdbc1.1.13|/usr/include|\"             \\\n    -i pkgs/tdbc1.1.13/tdbcConfig.sh\n\nsed -e \"s|$SRCDIR/unix/pkgs/itcl4.3.7|/usr/lib/itcl4.3.7|\" \\\n    -e \"s|$SRCDIR/pkgs/itcl4.3.7/generic|/usr/include|\"    \\\n    -e \"s|$SRCDIR/pkgs/itcl4.3.7|/usr/include|\"            \\\n    -i pkgs/itcl4.3.7/itclConfig.sh\n\nunset SRCDIR",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "test",
      "commands": [
        {
          "command": "LC_ALL=C.UTF-8 make test",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "tests-enabled"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "make install \nchmod 644 /usr/lib/libtclstub8.6.a",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "chmod -v u+w /usr/lib/libtcl8.6.so",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "make install-private-headers",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "ln -sfv tclsh8.6 /usr/bin/tclsh",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "mv -v /usr/share/man/man3/{{Thread,Tcl_Thread}}.3",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "cd ..\ntar -xf ../tcl{version}-html.tar.gz --strip-components=1\nmkdir -v -p /usr/share/doc/tcl-{version}\ncp -v -r  ./html/* /usr/share/doc/tcl-{version}",
          "user": "root"
        }
      ],
      "working_directory": "unix",
      "condition": "always"
    }
  ],
  "installed": {
    "programs": [
      "tclsh (link to tclsh8.6)",
      "tclsh8.6"
    ],
    "libraries": [
      "libtcl8.6.so",
      "libtclstub8.6.a"
    ]
  },
  "description": "The Tcl package contains the Tool Command Language, a robust general-purpose scripting language. The Expect package is written in Tcl (pronounced \"tickle\").",
  "document": {
    "section_id": "ch-system-tcl",
    "filename": "tcl.html",
    "contents_id": "contents-tcl"
  },
  "dependencies": {
    "build": [
      "Bash",
      "Binutils",
      "Coreutils",
      "Diffutils",
      "GCC",
      "Glibc",
      "Grep",
      "Make",
      "Sed"
    ],
    "runtime": [
      "Glibc",
      "Zlib"
    ],
    "test": [],
    "before": [],
    "optional": []
  },
  "installed_descriptions": [
    {
      "id": "tclsh8.6",
      "name": "tclsh8.6",
      "description": "The Tcl command shell"
    },
    {
      "id": "tclsh",
      "name": "tclsh",
      "description": "A link to tclsh8.6"
    },
    {
      "id": "libtcl8.6.so",
      "name": "libtcl8.6.so",
      "description": "The Tcl library"
    },
    {
      "id": "libtclstub8.6.a",
      "name": "libtclstub8.6.a",
      "description": "The Tcl Stub library"
    }
  ]
}
