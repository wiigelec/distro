{
  "schema_version": 1,
  "name": "pixman",
  "reference": {
    "blfs_section": "pixman",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup --prefix=/usr --buildtype=release .."
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "build",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "ninja test"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install"
        }
      ]
    }
  ],
  "description": "Pixman provides low-level pixel manipulation required by Xorg Server.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "xorg-server"
    ],
    "recommended": [],
    "optional": [
      "libpng",
      "GTK3"
    ]
  },
  "installed": {
    "programs": [],
    "libraries": [
      "libpixman-1.so"
    ],
    "directories": [
      "/usr/include/pixman-1"
    ]
  }
}
