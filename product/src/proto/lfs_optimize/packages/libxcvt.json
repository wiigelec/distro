{
  "schema_version": 1,
  "name": "libxcvt",
  "reference": {
    "blfs_section": "libxcvt",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup --prefix=/usr --buildtype=release .."
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install"
        }
      ]
    }
  ],
  "description": "libxcvt provides the standalone VESA CVT modeline generator required by Xorg Server.",
  "dependencies": {
    "build": [
      "xorg-libraries"
    ],
    "runtime": [],
    "test": [
      "No test suite available"
    ],
    "before": [
      "xorg-server"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "cvt"
    ],
    "libraries": [
      "libxcvt.so"
    ],
    "directories": [
      "/usr/include/libxcvt"
    ]
  }
}
