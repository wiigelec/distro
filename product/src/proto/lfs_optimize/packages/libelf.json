      "Glibc",
      "Xz",
      "Zlib",
      "Zstd"
    ],
    "test": [],
    "before": [
      "IProute2",
      "Linux"
    ],
    "optional": []
  },
  "installed_descriptions": [
    {
      "id": "libelf",
