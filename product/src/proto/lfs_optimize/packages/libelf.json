{
  "schema_version": 1,
  "name": "libelf",
  "reference": {
    "lfs_section": "ch-system-libelf"
  },
  "procedure": [
    {
      "phase": "configure",
      "commands": [
        {
          "command": "./configure --prefix=/usr        \\\n            --disable-debuginfod \\\n            --enable-libdebuginfod=dummy",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    },
    {
      "phase": "build",
      "commands": [
        {
          "command": "make -C lib\nmake -C libelf",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    },
    {
      "phase": "test",
      "commands": [
        {
          "command": "make -k check",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "tests-enabled"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "make -C libelf install\ninstall -vm644 config/libelf.pc /usr/lib/pkgconfig\nrm /usr/lib/libelf.a",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    }
  ],
  "installed": {
    "libraries": [
      "libelf.so"
    ],
    "directories": [
      "/usr/include/elfutils"
    ]
  },
  "description": "Libelf is a library for handling ELF (Executable and Linkable Format) files.",
  "document": {
    "section_id": "ch-system-libelf",
    "filename": "libelf.html",
    "contents_id": "contents-elfutils"
  },
  "dependencies": {
    "build": [
      "Bash",
