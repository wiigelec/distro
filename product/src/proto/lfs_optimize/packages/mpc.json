      "GCC",
      "Glibc",
      "Grep",
      "GMP",
      "Make",
      "MPFR",
      "Sed",
      "Texinfo"
    ],
    "runtime": [
      "Glibc",
      "GMP",
      "MPFR"
    ],
    "test": [],
