{
  "schema_version": 1,
  "name": "bison",
  "reference": {
    "lfs_section": "ch-system-bison"
  },
  "procedure": [
    {
      "phase": "configure",
      "commands": [
        {
          "command": "./configure --prefix=/usr --docdir=/usr/share/doc/bison-{version}",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    },
    {
      "phase": "build",
      "commands": [
        {
          "command": "make",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    },
    {
      "phase": "test",
      "commands": [
        {
          "command": "make check",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "tests-enabled"
    },
    {
      "phase": "install",
      "commands": [
        {
          "command": "make install",
          "user": "root"
        }
      ],
      "working_directory": "source",
      "condition": "always"
    }
  ],
  "installed": {
    "programs": [
      "bison",
      "yacc"
    ],
    "libraries": [
      "liby.a"
    ],
    "directories": [
      "/usr/share/bison"
    ]
  },
  "description": "The Bison package contains a parser generator.",
  "document": {
    "section_id": "ch-system-bison",
    "filename": "bison.html",
    "contents_id": "contents-bison"
  },
  "dependencies": {
    "build": [
      "Bash",
      "Binutils",
      "Coreutils",
      "Diffutils",
      "GCC",
      "Gettext",
      "Glibc",
      "Grep",
      "M4",
      "Make",
      "Perl",
      "Sed"
    ],
    "runtime": [
      "Glibc"
    ],
    "test": [
      "Diffutils",
      "Findutils",
      "Flex"
    ],
    "before": [
      "Kbd",
      "Tar"
    ],
    "optional": [
      "Doxygen"
    ]
  },
  "installed_descriptions": [
    {
      "id": "bison",
      "name": "bison",
      "description": "Generates, from a series of rules, a program for analyzing the structure of text files; Bison is a replacement for Yacc (Yet Another Compiler Compiler)"
    },
    {
      "id": "yacc",
      "name": "yacc",
      "description": "A wrapper for bison, meant for programs that still call yacc instead of bison; it calls bison with the -y option"
    },
    {
      "id": "liby",
      "name": "liby",
      "description": "The Yacc library containing implementations of Yacc-compatible yyerror and main functions; this library is normally not very useful, but POSIX requires it"
    }
  ]
}
