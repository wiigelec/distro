{
  "schema_version": 1,
  "name": "mtdev",
  "reference": {
    "blfs_section": "mtdev",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install && /sbin/ldconfig"
        }
      ]
    }
  ],
  "description": "mtdev translates Linux multitouch protocol variants for libinput.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "mtdev-test"
    ],
    "libraries": [
      "libmtdev.so"
    ],
    "directories": []
  }
}
