{
  "schema_version": 1,
  "name": "util-macros",
  "reference": {
    "blfs_section": "util-macros",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "source",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "make check"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "Xorg util-macros supplies the m4 macros used by the Xorg build.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "xorgproto"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [],
    "libraries": [],
    "directories": [
      "/usr/share/pkgconfig",
      "/usr/share/util-macros"
    ]
  }
}
