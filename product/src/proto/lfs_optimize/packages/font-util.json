{
  "schema_version": 1,
  "name": "font-util",
  "reference": {
    "blfs_section": "x7font",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "font-util is the Xorg font utility package required to build Xorg Server.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "xorg-server"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "bdftruncate",
      "ucs2any"
    ],
    "libraries": [],
    "directories": [
      "/usr/share/fonts"
    ]
  }
}
