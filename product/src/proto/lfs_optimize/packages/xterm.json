{
  "schema_version": 1,
  "name": "xterm",
  "reference": {
    "blfs_section": "xterm",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "sed -i '/v0/{n;s/new:/new:kb=^?:/}' termcap && printf '\\tkbs=\\\\177,\\n' >> terminfo && TERMINFO=/usr/share/terminfo ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --with-app-defaults=/etc/X11/app-defaults --enable-mini-luit --enable-wide-chars --enable-freetype"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install && mkdir -pv /usr/share/applications && cp -v *.desktop /usr/share/applications/ && mkdir -pv /etc/X11/app-defaults && printf '%s\\n' '*VT100*locale: UTF-8' '*VT100*faceName: DejaVu Sans Mono' '*VT100*faceSize: 10' '*backarrowKeyIsErase: true' '*ptyInitialErase: true' >> /etc/X11/app-defaults/XTerm"
        }
      ]
    }
  ],
  "description": "xterm is a terminal emulator for the X Window System. The M9 build uses xterm's built-in mini-luit support to avoid pulling the full Xorg Applications closure into the prototype.",
  "dependencies": {
    "build": [
      "xorg-libraries",
      "fontconfig",
      "freetype2"
    ],
    "runtime": [
      "xorg-libraries",
      "fontconfig",
      "freetype2",
      "dejavu-fonts"
    ],
    "test": [],
    "before": [],
    "recommended": [],
    "optional": [
      "luit"
    ]
  },
  "installed": {
    "programs": [
      "koi8rxterm",
      "resize",
      "uxterm",
      "xterm"
    ],
    "libraries": [],
    "directories": [
      "/etc/X11/app-defaults",
      "/usr/share/applications"
    ]
  }
}
