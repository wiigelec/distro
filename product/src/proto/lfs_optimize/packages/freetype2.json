{
  "schema_version": 1,
  "name": "freetype2",
  "reference": {
    "blfs_section": "freetype2",
    "edition": "13.1-systemd"
  },
  "procedure": [
    {
      "phase": "prepare",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "sed -ri \"s:.*(AUX_MODULES.*valid):\\\\1:\" modules.cfg"
        },
        {
          "user": "root",
          "command": "sed -r \"s:.*(#.*SUBPIXEL_RENDERING) .*:\\\\1:\" -i include/freetype/config/ftoption.h"
        }
      ]
    },
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --disable-static --enable-freetype-config --with-harfbuzz=dynamic"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ],
  "description": "FreeType2 provides font rendering support required by Fontconfig.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "fontconfig"
    ],
    "recommended": [
      "harfbuzz (runtime)",
      "libpng"
    ],
    "optional": [
      "brotli",
      "librsvg"
    ]
  },
  "installed": {
    "programs": [
      "freetype-config"
    ],
    "libraries": [
      "libfreetype.so"
    ],
    "directories": [
      "/usr/include/freetype2",
      "/usr/share/doc/freetype-{version}"
    ]
  }
}
