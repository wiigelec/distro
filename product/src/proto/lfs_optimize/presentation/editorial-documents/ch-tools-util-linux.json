      "type": "section",
      "title": "",
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Util-linux package contains miscellaneous utility programs."
            }
          ]
        },
        {
          "type": "segmented_list",
          "titles": [
            "Approximate build time",
            "Required disk space"
          ],
          "values": [
            "0.2 SBU",
            "211 MB"
          ]
        }
      ],
      "role": "package"
    },
    {
      "type": "section",
      "title": "Installation of Util-linux",
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The FHS recommends using the"
            },
            {
              "type": "code",
              "text": "/var/lib/hwclock"
            },
            {
              "type": "text",
              "text": "directory instead of the usual"
            },
            {
              "type": "code",
              "text": "/etc"
            },
            {
              "type": "text",
              "text": "directory as the location for the"
            },
            {
              "type": "code",
              "text": "adjtime"
            },
            {
              "type": "text",
              "text": "file. Create this directory with:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 0
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Prepare Util-linux for compilation:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 1
        },
        {
          "type": "definition_list",
          "title": "The meaning of the configure options:",
          "entries": [
            {
              "term": [
                {
                  "type": "code",
                  "text": "ADJTIME_PATH=/var/lib/hwclock/adjtime"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This sets the location of the file recording information about the hardware clock in accordance to the FHS. This is not strictly needed for this temporary tool, but it prevents creating a file at another location, which would not be overwritten or removed when building the final util-linux package."
                    }
                  ]
                }
              ]
            },
            {
              "term": [
                {
                  "type": "code",
                  "text": "--libdir=/usr/lib"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This switch ensures the"
                    },
                    {
                      "type": "code",
                      "text": ".so"
                    },
                    {
                      "type": "text",
                      "text": "symlinks targeting the shared library file in the same directory ("
                    },
                    {
                      "type": "code",
                      "text": "/usr/lib"
                    },
                    {
                      "type": "text",
                      "text": ") directly."
                    }
                  ]
                }
              ]
            },
            {
              "term": [
                {
                  "type": "code",
                  "text": "--disable-*"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "These switches prevent warnings about building components that require packages not in LFS or not installed yet."
                    }
                  ]
                }
              ]
            },
            {
              "term": [
                {
                  "type": "code",
                  "text": "--without-python"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This switch disables using"
                    },
                    {
                      "type": "code",
                      "text": "Python"
                    },
                    {
                      "type": "text",
                      "text": ". It avoids trying to build unneeded bindings."
                    }
                  ]
                }
              ]
            },
            {
              "term": [
                {
                  "type": "code",
                  "text": "runstatedir=/run"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This switch sets the location of the socket used by"
                    },
                    {
                      "type": "code",
                      "text": "uuidd"
                    },
                    {
                      "type": "text",
                      "text": "and"
                    },
                    {
                      "type": "code",
                      "text": "libuuid"
                    },
                    {
                      "type": "text",
                      "text": "correctly."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Compile the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 2
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Install the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 3
        }
      ],
      "role": "installation"
    },
