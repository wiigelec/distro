      "type": "section",
      "title": "",
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Binutils package contains a linker, an assembler, and other tools for handling object files."
            }
          ]
        },
        {
          "type": "segmented_list",
          "titles": [
            "Approximate build time",
            "Required disk space"
          ],
          "values": [
            "0.4 SBU",
            "560 MB"
          ]
        }
      ],
      "role": "package"
    },
    {
      "type": "section",
      "title": "Installation of Binutils",
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Binutils building system relies on an shipped libtool copy to link against internal static libraries, but the libiberty and zlib copies shipped in the package do not use libtool. This inconsistency may cause produced binaries mistakenly linked against libraries from the host distro. Work around this issue:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 0
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Create a separate build directory again:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 1
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Prepare Binutils for compilation:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 2
        },
        {
          "type": "definition_list",
          "title": "The meaning of the new configure options:",
          "entries": [
            {
              "term": [
                {
                  "type": "code",
                  "text": "--enable-shared"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Builds"
                    },
                    {
                      "type": "code",
                      "text": "libbfd"
                    },
                    {
                      "type": "text",
                      "text": "as a shared library."
                    }
                  ]
                }
              ]
            },
            {
              "term": [
                {
                  "type": "code",
                  "text": "--enable-64-bit-bfd"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Enables 64-bit support (on hosts with smaller word sizes). This may not be needed on 64-bit systems, but it does no harm."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Compile the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 3
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Install the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 4
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Remove the libtool archive files because they are harmful for cross compilation, and remove unnecessary static libraries:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 5
        }
      ],
      "role": "installation"
    },
