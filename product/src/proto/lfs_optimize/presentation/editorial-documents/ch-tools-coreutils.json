          "entries": [
            {
              "term": [
                {
                  "type": "code",
                  "text": "--enable-install-program=hostname"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This enables the"
