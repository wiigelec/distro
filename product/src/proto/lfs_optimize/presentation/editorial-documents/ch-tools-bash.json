      "type": "section",
      "title": "Installation of Bash",
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Prepare Bash for compilation:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 0
        },
        {
          "type": "definition_list",
          "title": "The meaning of the configure options:",
          "entries": [
            {
              "term": [
                {
                  "type": "code",
                  "text": "--without-bash-malloc"
                }
              ],
              "blocks": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This option turns off the use of Bash's memory allocation ("
                    },
                    {
                      "type": "code",
                      "text": "malloc"
                    },
                    {
                      "type": "text",
                      "text": ") function which is known to cause segmentation faults. By turning this option off, Bash will use the"
                    },
                    {
                      "type": "code",
                      "text": "malloc"
                    },
                    {
                      "type": "text",
                      "text": "functions from Glibc which are more stable."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Compile the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 1
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Install the package:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 2
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Make a link for the programs that use"
            },
            {
              "type": "code",
              "text": "sh"
            },
            {
              "type": "text",
              "text": "for a shell:"
            }
          ]
        },
        {
          "type": "bootstrap_command",
          "index": 3
        }
