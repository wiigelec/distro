              "text": "FORCE_UNSAFE_CONFIGURE=1"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This forces the test for"
                },
                {
                  "type": "function",
                  "text": "mknod"
                },
                {
                  "type": "text",
                  "text": "to be run as"
                },
                {
                  "type": "systemitem",
                  "text": "root"
                },
                {
                  "type": "text",
                  "text": ". It is generally considered dangerous to run this test as the"
                },
                {
                  "type": "systemitem",
                  "text": "root"
                },
                {
                  "type": "text",
                  "text": "user, but as it is being run on a system that has only been partially built, overriding it is OK."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Compile the package:"
