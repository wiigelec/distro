  "installation_blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This version of Perl builds the Compress::Raw::Zlib and Compress::Raw::BZip2 modules. By default Perl will use an internal copy of the sources for the build. Issue the following command so that Perl will use the libraries installed on the system:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "To have full control over the way Perl is set up, you can remove the"
        },
        {
          "type": "quote",
          "text": "-des"
        },
        {
          "type": "text",
          "text": "options from the following command and hand-pick the way this package is built. Alternatively, use the command exactly as shown below to use the defaults that Perl auto-detects:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "definition-list",
      "title": "The meaning of the new Configure options:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "-D pager=\"/usr/bin/less -isR\""
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This ensures that less is used instead of more ."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "-D man1dir=/usr/share/man/man1 -D man3dir=/usr/share/man/man3"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Since Groff is not installed yet,"
                },
                {
                  "type": "command",
                  "text": "Configure"
                },
                {
                  "type": "text",
                  "text": "will not create man pages for Perl. These parameters override this behavior."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "-D usethreads"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Build Perl with support for threads."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Compile the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "To test the results, issue:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 3
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Install the package and clean up:"
        }
      ]
    },
    {
