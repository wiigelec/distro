      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Groff expects the environment variable "
        },
        {
          "type": "envar",
          "text": "PAGE"
        },
        {
          "type": "text",
          "text": " to contain the default paper size. For users in the United States, "
        },
        {
          "type": "literal",
          "text": "PAGE=letter"
        },
        {
          "type": "text",
          "text": " is appropriate. Elsewhere, "
        },
        {
          "type": "literal",
          "text": "PAGE=A4"
        },
        {
          "type": "text",
          "text": " may be more suitable. While the default paper size is configured during compilation, it can be overridden later by writing either A4 or letter to "
        },
        {
          "type": "filename",
          "text": "/etc/papersize"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
