  "installation_blocks": [
    {
      "type": "paragraph",
      "text": "POSIX requires that programs from Coreutils recognize character boundaries correctly even in multibyte locales. Apply the internationalization patch:"
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "admonition",
      "kind": "note",
      "paragraphs": [
        "Many bugs have been found in this patch. When reporting new bugs to the Coreutils maintainers, first check whether they are reproducible without this patch."
      ]
    },
    {
      "type": "paragraph",
      "text": "Now prepare Coreutils for compilation:"
    },
    {
      "type": "command-group",
      "command_indices": [
        1,
        2,
        3
      ]
    },
    {
      "type": "paragraph",
      "text": "Compile the package:"
    },
    {
      "type": "command",
      "command_index": 4
    },
    {
      "type": "paragraph",
      "text": "If running the test suite, first run the tests intended for the root user:"
    },
    {
      "type": "command",
      "command_index": 5
    },
    {
      "type": "paragraph",
      "text": "Add a temporary group and make tester a member so tests requiring multiple groups are not skipped:"
    },
    {
      "type": "command",
      "command_index": 6
    },
    {
      "type": "paragraph",
      "text": "Fix permissions so the non-root user can compile and run the tests:"
    },
    {
      "type": "command",
      "command_index": 7
    },
    {
      "type": "paragraph",
      "text": "Run the remainder of the tests as tester:"
    },
    {
      "type": "command",
      "command_index": 8
    },
    {
      "type": "paragraph",
      "text": "Remove the temporary group:"
    },
    {
      "type": "command",
      "command_index": 9
    },
    {
      "type": "paragraph",
      "text": "Install the package:"
    },
    {
      "type": "command",
      "command_index": 10
    },
    {
      "type": "paragraph",
      "text": "Move programs to the locations specified by the FHS:"
    },
    {
      "type": "command-group",
      "command_indices": [
        11,
        12,
        13
      ]
    }
  ],
