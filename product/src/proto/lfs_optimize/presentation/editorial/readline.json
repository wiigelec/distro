{
  "schema_version": 1,
  "package": "readline",
  "installation_title": "Installation of Readline",
  "contents_title": "Contents of Readline",
  "installed_labels": {
    "libraries": "Installed libraries",
    "directories": "Installed directories"
  },
  "installation_blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Reinstalling Readline will cause the old libraries to be moved to <libraryname>.old. While this is normally not a problem, in some cases it can trigger a linking bug in"
        },
        {
          "type": "command",
          "text": "ldconfig"
        },
        {
          "type": "text",
          "text": ". This can be avoided by issuing the following two seds:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prevent hard coding library search paths (rpath) into the shared libraries. This package does not need rpath for an installation into the standard location, and rpath may sometimes cause unwanted effects or even security issues:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Fix a problem identified upstream specifically for this version of readline:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prepare Readline for compilation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 3
    },
    {
      "type": "definition-list",
      "title": "The meaning of the new configure option:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--with-curses"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option tells Readline that it can find the termcap library functions in the curses library, not a separate termcap library. This will generate the correct"
                },
                {
                  "type": "filename",
                  "text": "readline.pc"
                },
                {
                  "type": "text",
                  "text": "file."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Compile the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 4
    },
    {
      "type": "definition-list",
      "title": "The meaning of the make option:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "SHLIB_LIBS=\"-lncursesw\""
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option forces Readline to link against the"
                },
                {
                  "type": "filename",
                  "text": "libncursesw"
                },
                {
                  "type": "text",
                  "text": "library. For details see the"
                },
                {
                  "type": "quote",
                  "text": "Shared Libraries"
                },
                {
                  "type": "text",
                  "text": "section in the package's"
                },
                {
                  "type": "filename",
                  "text": "README"
                },
                {
                  "type": "text",
                  "text": "file."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This package does not come with a test suite."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Install the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 5
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "If desired, install the documentation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 6
    }
  ]
}
