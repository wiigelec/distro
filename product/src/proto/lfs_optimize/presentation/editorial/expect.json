{
  "schema_version": 1,
  "package": "expect",
  "installation_title": "Installation of Expect",
  "contents_title": "Contents of Expect",
  "installed_labels": {
    "programs": "Installed program",
    "libraries": "Installed library"
  },
  "installation_blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Expect needs PTYs to work. Verify that the PTYs are working properly inside the chroot environment by performing a simple test:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This command should output"
        },
        {
          "type": "computeroutput",
          "text": "ok"
        },
        {
          "type": "text",
          "text": ". If, instead, the output includes"
        },
        {
          "type": "computeroutput",
          "text": "OSError: out of pty devices"
        },
        {
          "type": "text",
          "text": ", then the environment is not set up for proper PTY operation. You need to exit from the chroot environment, read"
        },
        {
          "type": "xref",
          "target": "ch-tools-kernfs",
          "label": "Preparing Virtual Kernel File Systems"
        },
        {
          "type": "text",
          "text": "again, and ensure the"
        },
        {
          "type": "systemitem",
          "text": "devpts"
        },
        {
          "type": "text",
          "text": "file system (and other virtual kernel file systems) mounted correctly. Then reenter the chroot environment following"
        },
        {
          "type": "xref",
          "target": "ch-tools-chroot",
          "label": "Entering the Chroot Environment"
        },
        {
          "type": "text",
          "text": ". This issue needs to be resolved before continuing, or the test suites requiring Expect (for example the test suites of Bash, Binutils, GCC, GDBM, and of course Expect itself) will fail catastrophically, and other subtle breakages may also happen."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now, make some changes to allow the package with gcc-15.1 or later:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prepare Expect for compilation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "definition-list",
      "title": "The meaning of the configure options:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--with-tcl=/usr/lib"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This parameter is needed to tell"
                },
                {
                  "type": "command",
                  "text": "configure"
                },
                {
                  "type": "text",
                  "text": "where the"
                },
                {
                  "type": "command",
                  "text": "tclConfig.sh"
                },
                {
                  "type": "text",
                  "text": "script is located."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--with-tclinclude=/usr/include"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This explicitly tells Expect where to find Tcl's internal headers."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Build the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 3
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "To test the results, issue:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 4
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Install the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 5
    }
  ]
}
