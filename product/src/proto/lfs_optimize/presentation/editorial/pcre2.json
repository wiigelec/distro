      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prepare pcre2 for compilation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "definition-list",
      "title": "The meaning of the new configure options:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-unicode"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option enables Unicode support and includes the functions for handling UTF-8/16/32 character strings in the library."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-jit"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option enables Just-in-time compiling, which can greatly speed up pattern matching."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-pcre2-16"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option enables 16 bit character support."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-pcre2-32"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option enables 32 bit character support."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-pcre2grep-libz"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option adds support for reading .gz compressed files to pcre2grep."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-pcre2grep-libbz2"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option adds support for reading .bz2 compressed files to pcre2grep."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-pcre2test-libreadline"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option adds line editing and history features to the pcre2test program."
                }
              ]
            }
          ]
        }
      ]
    },
