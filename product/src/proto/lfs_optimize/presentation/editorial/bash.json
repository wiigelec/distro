{
  "schema_version": 1,
  "package": "bash",
  "installation_title": "Installation of Bash",
  "contents_title": "Contents of Bash",
  "installed_labels": {
    "programs": "Installed programs",
    "directories": "Installed directory"
  },
  "installation_blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prepare Bash for compilation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "definition-list",
      "title": "The meaning of the new configure option:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--with-installed-readline"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option tells Bash to use the"
                },
                {
                  "type": "filename",
                  "text": "readline"
                },
                {
                  "type": "text",
                  "text": "library that is already installed on the system rather than using its own readline version."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Compile the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Skip down to"
        },
        {
          "type": "quote",
          "text": "Install the package"
        },
        {
          "type": "text",
          "text": "if not running the test suite."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "To prepare the tests, ensure that the"
        },
        {
          "type": "systemitem",
          "text": "tester"
        },
        {
          "type": "text",
          "text": "user can write to the sources tree:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The test suite of this package is designed to be run as a non-"
        },
        {
          "type": "systemitem",
          "text": "root"
        },
        {
          "type": "text",
          "text": "user who owns the terminal connected to standard input. To satisfy the requirement, spawn a new pseudo terminal using"
        },
        {
          "type": "application",
          "text": "Expect"
        },
        {
          "type": "text",
          "text": "and run the tests as the"
        },
        {
          "type": "systemitem",
          "text": "tester"
        },
        {
          "type": "text",
          "text": "user:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 3
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The test suite uses"
        },
        {
          "type": "command",
          "text": "diff"
        },
        {
          "type": "text",
          "text": "to detect the difference between test script output and the expected output. Any output from"
        },
        {
          "type": "command",
          "text": "diff"
        },
        {
          "type": "text",
          "text": "(prefixed with"
        },
        {
          "type": "computeroutput",
          "text": "<"
        },
        {
          "type": "text",
          "text": "and"
        },
        {
          "type": "computeroutput",
          "text": ">"
        },
        {
          "type": "text",
          "text": ") indicates a test failure, unless there is a message saying the difference can be ignored. The test named"
        },
        {
          "type": "filename",
          "text": "run-builtins"
        },
        {
          "type": "text",
          "text": "is known to fail on some host distros with a difference on the 479 and 480 lines of the output. Some other tests need the"
        },
        {
          "type": "literal",
          "text": "zh_TW.BIG5"
        },
        {
          "type": "text",
          "text": "and"
        },
        {
          "type": "literal",
          "text": "ja_JP.SJIS"
        },
        {
          "type": "text",
          "text": "locales, they are known to fail unless those locales are installed."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Install the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 4
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Run the newly compiled"
        },
        {
          "type": "command",
          "text": "bash"
        },
        {
          "type": "text",
          "text": "program (replacing the one that is currently being executed):"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 5
    }
  ]
}
