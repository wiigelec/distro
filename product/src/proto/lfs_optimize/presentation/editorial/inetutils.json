{
  "schema_version": 1,
  "package": "inetutils",
  "installation_title": "Installation of Inetutils",
  "contents_title": "Contents of Inetutils",
  "installed_labels": {
    "programs": "Installed programs"
  },
  "installation_blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "First, make the package build with gcc-14.1 or later:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Prepare Inetutils for compilation:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "definition-list",
      "title": "The meaning of the configure options:",
      "items": [
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--disable-logger"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option prevents Inetutils from installing the"
                },
                {
                  "type": "command",
                  "text": "logger"
                },
                {
                  "type": "text",
                  "text": "program, which is used by scripts to pass messages to the System Log Daemon. Do not install it because Util-linux installs a more recent version."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--disable-whois"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This option disables the building of the Inetutils"
                },
                {
                  "type": "command",
                  "text": "whois"
                },
                {
                  "type": "text",
                  "text": "client, which is out of date. Instructions for a better"
                },
                {
                  "type": "command",
                  "text": "whois"
                },
                {
                  "type": "text",
                  "text": "client are in the BLFS book."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--disable-r*"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "These parameters disable building obsolete programs that should not be used due to security issues. The functions provided by these programs can be provided by the"
                },
                {
                  "type": "application",
                  "text": "openssh"
                },
                {
                  "type": "text",
                  "text": "package in the BLFS book."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--disable-servers"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This disables the installation of the various network servers included as part of the Inetutils package. These servers are deemed not appropriate in a basic LFS system. Some are insecure by nature and are only considered safe on trusted networks. Note that better replacements are available for many of these servers."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Compile the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "To test the results, issue:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 3
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Install the package:"
        }
      ]
    },
    {
      "type": "command",
      "command_index": 4
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Move a program to the proper location:"
        }
      ]
    },
