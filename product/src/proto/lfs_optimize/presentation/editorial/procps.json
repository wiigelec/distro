          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This switch enables the ncursesw support for the"
                },
                {
                  "type": "command",
                  "text": "watch"
                },
                {
                  "type": "text",
                  "text": "command, so it can handle 8-bit characters."
                }
              ]
            }
          ]
        }
