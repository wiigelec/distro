  "installation_blocks": [
    {
      "type": "paragraph",
      "text": "Prepare Util-linux for compilation:"
    },
    {
      "type": "command",
      "command_index": 0
    },
    {
      "type": "paragraph",
      "text": "The --disable and --without options prevent warnings about building components that either require packages not in LFS, or are inconsistent with programs installed by other packages."
    },
    {
      "type": "paragraph",
      "text": "Compile the package:"
    },
    {
      "type": "command",
      "command_index": 1
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "If desired, create a dummy "
        },
        {
          "type": "filename",
          "text": "/etc/fstab"
        },
        {
          "type": "text",
          "text": " file to satisfy two tests and run the test suite as a non-root user:"
        }
      ]
    },
    {
      "type": "admonition",
      "kind": "warning",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Running the test suite as the root user can be harmful to your system. To run it, the CONFIG_SCSI_DEBUG option for the kernel must be available in the currently running system and must be built as a module. Building it into the kernel will prevent booting. For complete coverage, other BLFS packages must be installed. If desired, this test can be run by booting into the completed LFS system and running:"
        },
        {
          "type": "supplemental-command",
          "procedure": "full-coverage-tests",
          "command_index": 0
        }
      ]
    },
    {
      "type": "command",
      "command_index": 2
    },
    {
      "type": "paragraph",
      "text": "The lsfd: inotify test will fail if the kernel option CONFIG_NETLINK_DIAG is not enabled."
    },
    {
      "type": "paragraph",
      "text": "Install the package:"
    },
    {
      "type": "command",
      "command_index": 3
    }
  ],
