        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--disable-setuid"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This disables making the"
                },
                {
                  "type": "command",
                  "text": "man"
                },
                {
                  "type": "text",
                  "text": "program setuid to user"
                },
                {
                  "type": "systemitem",
                  "text": "man"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--enable-cache-owner=bin"
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This changes ownership of the system-wide cache files to user"
                },
                {
                  "type": "systemitem",
                  "text": "bin"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "term_content": [
            {
              "type": "parameter",
              "text": "--with-..."
            }
          ],
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "These three parameters are used to set some default programs."
                },
                {
                  "type": "command",
                  "text": "lynx"
                },
                {
                  "type": "text",
                  "text": "is a text-based web browser (see BLFS for installation instructions),"
                },
                {
                  "type": "command",
                  "text": "vgrind"
                },
                {
                  "type": "text",
                  "text": "converts program sources to Groff input, and"
                },
                {
                  "type": "command",
                  "text": "grap"
                },
                {
                  "type": "text",
                  "text": "is useful for typesetting graphs in Groff documents. The"
                },
                {
                  "type": "command",
                  "text": "vgrind"
                },
                {
                  "type": "text",
                  "text": "and"
                },
                {
                  "type": "command",
                  "text": "grap"
                },
                {
                  "type": "text",
                  "text": "programs are not normally needed for viewing manual pages. They are not part of LFS or BLFS, but you should be able to install them yourself after finishing LFS if you wish to do so."
                }
              ]
            }
          ]
        }
