  "stages": [
    {
      "id": "ch-tools-binutils-pass1",
      "package": "binutils",
      "context": "host-builder",
      "title": "Binutils-2.47 - Pass 1",
      "commands": [
        "mkdir -v build\ncd       build",
        "../configure --prefix=$LFS/tools \\\n             --with-sysroot=$LFS \\\n             --target=$LFS_TGT   \\\n             --disable-nls       \\\n             --enable-gprofng=no \\\n             --disable-werror    \\\n             --enable-new-dtags  \\\n             --enable-default-hash-style=gnu",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-gcc-pass1",
      "package": "gcc",
      "context": "host-builder",
      "title": "GCC-16.2.0 - Pass 1",
      "commands": [
        "tar -xf ../mpfr-4.2.2.tar.xz\nmv -v mpfr-4.2.2 mpfr\ntar -xf ../gmp-6.3.0.tar.xz\nmv -v gmp-6.3.0 gmp\ntar -xf ../mpc-1.4.1.tar.xz\nmv -v mpc-1.4.1 mpc",
        "case $(uname -m) in\n  x86_64)\n    sed -e '/m64=/s/lib64/lib/' \\\n        -i.orig gcc/config/i386/t-linux64\n ;;\nesac",
        "mkdir -v build\ncd       build",
        "../configure                  \\\n    --target=$LFS_TGT         \\\n    --prefix=$LFS/tools       \\\n    --with-glibc-version=2.44 \\\n    --with-sysroot=$LFS       \\\n    --with-newlib             \\\n    --without-headers         \\\n    --enable-default-pie      \\\n    --enable-default-ssp      \\\n    --disable-fixincludes     \\\n    --disable-nls             \\\n    --disable-shared          \\\n    --disable-multilib        \\\n    --disable-threads         \\\n    --disable-libatomic       \\\n    --disable-libgomp         \\\n    --disable-libquadmath     \\\n    --disable-libssp          \\\n    --disable-libvtv          \\\n    --disable-libstdcxx       \\\n    --enable-languages=c,c++",
        "make",
        "make install",
        "cat ../gcc/{limitx,glimits,limity}.h  > \\\n  $($LFS_TGT-gcc -print-file-name=include)/limits.h"
      ]
    },
    {
      "id": "ch-tools-linux-headers",
      "package": "linux",
      "context": "host-builder",
      "title": "Linux-7.1.8 API Headers",
      "commands": [
        "make mrproper",
        "make headers\nfind usr/include -type f ! -name '*.h' -delete",
        "cp -rv usr/include $LFS/usr"
      ]
    },
    {
      "id": "ch-tools-glibc",
      "package": "glibc",
      "context": "host-builder",
      "title": "Glibc-2.44",
      "commands": [
        "case $(uname -m) in\n    i?86)   ln -sfv ld-linux.so.2 $LFS/lib/ld-lsb.so.3\n    ;;\n    x86_64) ln -sfv ../lib/ld-linux-x86-64.so.2 $LFS/lib64\n            ln -sfv ../lib/ld-linux-x86-64.so.2 $LFS/lib64/ld-lsb-x86-64.so.3\n    ;;\nesac",
        "patch -Np1 -i ../glibc-fhs-1.patch",
        "patch -Np1 -i ../glibc-2.44-upstream_fixes-1.patch",
        "mkdir -v build\ncd       build",
        "echo \"rootsbindir=/usr/sbin\" > configparms",
        "../configure                             \\\n      --prefix=/usr                      \\\n      --host=$LFS_TGT                    \\\n      --build=$(../scripts/config.guess) \\\n      --disable-nscd                     \\\n      libc_cv_slibdir=/usr/lib           \\\n      --enable-kernel=5.10",
        "make",
        "make DESTDIR=$LFS install",
        "sed '/RTLDLIST=/s@/usr@@g' -i $LFS/usr/bin/ldd",
        "echo 'int main(){}' | $LFS_TGT-gcc -x c - -v -Wl,--verbose &> dummy.log\n$LFS_TGT-readelf -l a.out | grep ': /lib'",
        "grep -E -o \"$LFS/lib.*/S?crt[1in].*succeeded\" dummy.log",
        "grep -B3 \"^ $LFS/usr/include\" dummy.log",
        "grep 'SEARCH.*/usr/lib' dummy.log |sed 's|; |\\n|g'",
        "grep \"/lib.*/libc.so.6 \" dummy.log",
        "grep found dummy.log",
        "rm -v a.out dummy.log"
      ]
    },
    {
      "id": "ch-tools-libstdcpp",
      "package": "gcc",
      "context": "host-builder",
      "title": "Libstdc++ from GCC-16.2.0",
      "commands": [
        "mkdir -v build\ncd       build",
        "../libstdc++-v3/configure      \\\n    --host=$LFS_TGT            \\\n    --build=$(../config.guess) \\\n    CXX=$LFS_TGT-gcc           \\\n    --prefix=/usr              \\\n    --disable-multilib         \\\n    --disable-nls              \\\n    --disable-libstdcxx-pch    \\\n    --with-gxx-include-dir=/tools/$LFS_TGT/include/c++/16.2.0",
        "make",
        "make DESTDIR=$LFS install",
        "rm -v $LFS/usr/lib/lib{stdc++{,exp,fs},supc++}.la"
      ]
    },
    {
      "id": "ch-tools-m4",
      "package": "m4",
      "context": "host-builder",
      "title": "M4-1.4.21",
      "commands": [
        "cat > $LFS/usr/share/config.site << EOF\nac_cv_func_posix_spawn_file_actions_addchdir=yes\nac_cv_func_posix_spawn_file_actions_addfchdir=yes\nEOF",
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-ncurses",
      "package": "ncurses",
      "context": "host-builder",
      "title": "Ncurses-6.6",
      "commands": [
        "mkdir build\npushd build\n  ../configure --prefix=$LFS/tools AWK=gawk\n  make -C include\n  make -C progs tic\n  install progs/tic $LFS/tools/bin\npopd",
        "./configure --prefix=/usr                \\\n            --host=$LFS_TGT              \\\n            --build=$(./config.guess)    \\\n            --mandir=/usr/share/man      \\\n            --with-manpage-format=normal \\\n            --with-shared                \\\n            --without-normal             \\\n            --with-cxx-shared            \\\n            --without-debug              \\\n            --without-ada                \\\n            --disable-stripping          \\\n            AWK=gawk",
        "make",
        "make DESTDIR=$LFS install\nln -sv libncursesw.so $LFS/usr/lib/libncurses.so\nsed -e 's/^#if.*XOPEN.*$/#if 1/' \\\n    -i $LFS/usr/include/curses.h"
      ]
    },
    {
      "id": "ch-tools-bash",
      "package": "bash",
      "context": "host-builder",
      "title": "Bash-5.3",
      "commands": [
        "./configure --prefix=/usr                      \\\n            --build=$(sh support/config.guess) \\\n            --host=$LFS_TGT                    \\\n            --without-bash-malloc              \\\n            --docdir=/usr/share/doc/bash-5.3",
        "make",
        "make DESTDIR=$LFS install",
        "ln -sv bash $LFS/bin/sh"
      ]
    },
    {
      "id": "ch-tools-coreutils",
      "package": "coreutils",
      "context": "host-builder",
      "title": "Coreutils-9.11",
      "commands": [
        "./configure --prefix=/usr                     \\\n            --host=$LFS_TGT                   \\\n            --build=$(build-aux/config.guess) \\\n            --enable-install-program=hostname",
        "make",
        "make DESTDIR=$LFS install",
        "mv -v $LFS/usr/bin/chroot              $LFS/usr/sbin\nmkdir -pv $LFS/usr/share/man/man8\nmv -v $LFS/usr/share/man/man1/chroot.1 $LFS/usr/share/man/man8/chroot.8\nsed -i 's/\"1\"/\"8\"/'                    $LFS/usr/share/man/man8/chroot.8"
      ]
    },
    {
      "id": "ch-tools-diffutils",
      "package": "diffutils",
      "context": "host-builder",
      "title": "Diffutils-3.12",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            gl_cv_func_strcasecmp_works=yes \\\n            --build=$(./build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-file",
      "package": "file",
      "context": "host-builder",
      "title": "File-5.48",
      "commands": [
        "mkdir build\npushd build\n  ../configure --disable-bzlib      \\\n               --disable-libseccomp \\\n               --disable-xzlib      \\\n               --disable-zlib\n  make\npopd",
        "./configure --prefix=/usr --host=$LFS_TGT --build=$(./config.guess)",
        "make FILE_COMPILE=$(pwd)/build/src/file",
        "make DESTDIR=$LFS install",
        "rm -v $LFS/usr/lib/libmagic.la"
      ]
    },
    {
      "id": "ch-tools-findutils",
      "package": "findutils",
      "context": "host-builder",
      "title": "Findutils-4.11.0",
      "commands": [
        "./configure --prefix=/usr                   \\\n            --localstatedir=/var/lib/locate \\\n            --host=$LFS_TGT                 \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-gawk",
      "package": "gawk",
      "context": "host-builder",
      "title": "Gawk-5.4.1",
      "commands": [
        "sed -i 's/extras//' Makefile.in",
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-grep",
      "package": "grep",
      "context": "host-builder",
      "title": "Grep-3.12",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(./build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-gzip",
      "package": "gzip",
      "context": "host-builder",
      "title": "Gzip-1.14",
      "commands": [
        "./configure --prefix=/usr --host=$LFS_TGT",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-make",
      "package": "make",
      "context": "host-builder",
      "title": "Make-4.4.1",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-patch",
      "package": "patch",
      "context": "host-builder",
      "title": "Patch-2.8",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-sed",
      "package": "sed",
      "context": "host-builder",
      "title": "Sed-4.10",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(./build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-tar",
      "package": "tar",
      "context": "host-builder",
      "title": "Tar-1.35",
      "commands": [
        "./configure --prefix=/usr   \\\n            --host=$LFS_TGT \\\n            --build=$(build-aux/config.guess)",
        "make",
        "make DESTDIR=$LFS install"
      ]
    },
    {
      "id": "ch-tools-xz",
      "package": "xz",
      "context": "host-builder",
      "title": "Xz-5.8.3",
      "commands": [
        "./configure --prefix=/usr                     \\\n            --host=$LFS_TGT                   \\\n            --build=$(build-aux/config.guess) \\\n            --disable-static                  \\\n            --docdir=/usr/share/doc/xz-5.8.3",
        "make",
        "make DESTDIR=$LFS install",
        "rm -v $LFS/usr/lib/liblzma.la"
      ]
    },
    {
      "id": "ch-tools-binutils-pass2",
      "package": "binutils",
      "context": "host-builder",
      "title": "Binutils-2.47 - Pass 2",
      "commands": [
        "sed '6031s/$add_dir//' -i ltmain.sh",
        "mkdir -v build\ncd       build",
        "../configure                   \\\n    --prefix=/usr              \\\n    --build=$(../config.guess) \\\n    --host=$LFS_TGT            \\\n    --disable-nls              \\\n    --enable-shared            \\\n    --enable-gprofng=no        \\\n    --disable-werror           \\\n    --enable-64-bit-bfd        \\\n    --enable-new-dtags         \\\n    --enable-default-hash-style=gnu",
        "make",
        "make DESTDIR=$LFS install",
        "rm -v $LFS/usr/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.{a,la}"
      ]
    },
    {
      "id": "ch-tools-gcc-pass2",
      "package": "gcc",
      "context": "host-builder",
      "title": "GCC-16.2.0 - Pass 2",
      "commands": [
        "tar -xf ../mpfr-4.2.2.tar.xz\nmv -v mpfr-4.2.2 mpfr\ntar -xf ../gmp-6.3.0.tar.xz\nmv -v gmp-6.3.0 gmp\ntar -xf ../mpc-1.4.1.tar.xz\nmv -v mpc-1.4.1 mpc",
        "case $(uname -m) in\n  x86_64)\n    sed -e '/m64=/s/lib64/lib/' \\\n        -i.orig gcc/config/i386/t-linux64\n  ;;\nesac",
        "mkdir -v build\ncd       build",
        "../configure                   \\\n    --build=$(../config.guess) \\\n    --host=$LFS_TGT            \\\n    --target=$LFS_TGT          \\\n    --prefix=/usr              \\\n    --with-build-sysroot=$LFS  \\\n    --enable-default-pie       \\\n    --enable-default-ssp       \\\n    --disable-fixincludes      \\\n    --disable-nls              \\\n    --disable-multilib         \\\n    --disable-libatomic        \\\n    --disable-libgomp          \\\n    --disable-libquadmath      \\\n    --disable-libsanitizer     \\\n    --disable-libssp           \\\n    --disable-libvtv           \\\n    --enable-languages=c,c++   \\\n    CXX_FOR_TARGET=\"$LFS_TGT-gcc -nostdinc++\" \\\n    LDFLAGS_FOR_TARGET=-L$PWD/$LFS_TGT/libgcc \\\n    target_configargs=gcc_cv_target_thread_file=posix",
        "make",
        "make DESTDIR=$LFS install",
        "ln -sv gcc $LFS/usr/bin/cc"
      ]
    },
    {
      "id": "ch-tools-gettext",
      "package": "gettext",
      "context": "chroot-root",
      "title": "Gettext-1.0",
      "commands": [
        "./configure --disable-shared",
        "make",
        "cp -v gettext-tools/src/{msgfmt,msgmerge,xgettext} /usr/bin"
      ]
    },
    {
      "id": "ch-tools-bison",
      "package": "bison",
      "context": "chroot-root",
      "title": "Bison-3.8.2",
      "commands": [
        "./configure --prefix=/usr \\\n            --docdir=/usr/share/doc/bison-3.8.2",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-perl",
      "package": "perl",
      "context": "chroot-root",
      "title": "Perl-5.44.0",
      "commands": [
        "sh Configure -des                                         \\\n             -D prefix=/usr                               \\\n             -D vendorprefix=/usr                         \\\n             -D useshrplib                                \\\n             -D privlib=/usr/lib/perl5/5.44/core_perl     \\\n             -D archlib=/usr/lib/perl5/5.44/core_perl     \\\n             -D sitelib=/usr/lib/perl5/5.44/site_perl     \\\n             -D sitearch=/usr/lib/perl5/5.44/site_perl    \\\n             -D vendorlib=/usr/lib/perl5/5.44/vendor_perl \\\n             -D vendorarch=/usr/lib/perl5/5.44/vendor_perl",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-zlib",
      "package": "zlib",
      "context": "chroot-root",
      "title": "Zlib-1.3.2",
      "commands": [
        "./configure --prefix=/usr",
        "make",
        "make install",
        "rm -fv /usr/lib/libz.a"
      ]
    },
    {
      "id": "ch-tools-mpdecimal",
      "package": "mpdecimal",
      "context": "chroot-root",
      "title": "mpdecimal-4.0.1",
      "commands": [
        "./configure --prefix=/usr    \\\n            --disable-static \\\n            --docdir=/usr/share/doc/mpdecimal-4.0.1",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-Python",
      "package": "Python",
      "context": "chroot-root",
      "title": "Python-3.14.7",
      "commands": [
        "./configure --prefix=/usr       \\\n            --enable-shared     \\\n            --without-ensurepip \\\n            --without-static-libpython",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-texinfo",
      "package": "texinfo",
      "context": "chroot-root",
      "title": "Texinfo-7.3",
      "commands": [
        "./configure --prefix=/usr",
        "make",
        "make install"
      ]
    },
    {
      "id": "ch-tools-util-linux",
      "package": "util-linux",
      "context": "chroot-root",
      "title": "Util-linux-2.42.2",
      "commands": [
        "mkdir -pv /var/lib/hwclock",
        "./configure --libdir=/usr/lib     \\\n            --runstatedir=/run    \\\n            --disable-chfn-chsh   \\\n            --disable-login       \\\n            --disable-nologin     \\\n            --disable-su          \\\n            --disable-setpriv     \\\n            --disable-runuser     \\\n            --disable-pylibmount  \\\n            --disable-static      \\\n            --disable-liblastlog2 \\\n            --without-python      \\\n            ADJTIME_PATH=/var/lib/hwclock/adjtime \\\n            --docdir=/usr/share/doc/util-linux-2.42.2",
        "make",
        "make install"
      ]
    }
  ],
  "chroot_setup": [
    "mkdir -pv /{boot,home,mnt,opt,srv}",
    "mkdir -pv /etc/{opt,sysconfig}\nmkdir -pv /lib/firmware\nmkdir -pv /media/{floppy,cdrom}\nmkdir -pv /usr/{,local/}{include,src}\nmkdir -pv /usr/lib/locale\nmkdir -pv /usr/local/{bin,lib,sbin}\nmkdir -pv /usr/{,local/}share/{color,dict,doc,info,locale,man}\nmkdir -pv /usr/{,local/}share/{misc,terminfo,zoneinfo}\nmkdir -pv /usr/{,local/}share/man/man{1..8}\nmkdir -pv /var/{cache,local,log,mail,opt,spool}\nmkdir -pv /var/lib/{color,misc,locate}\n\nln -sfv /run /var/run\nln -sfv /run/lock /var/lock\n\ninstall -dv -m 0750 /root\ninstall -dv -m 1777 /tmp /var/tmp",
    "ln -sv /proc/self/mounts /etc/mtab",
    "cat > /etc/hosts << EOF\n127.0.0.1  localhost $(hostname)\n::1        localhost\nEOF",
    "cat > /etc/passwd << \"EOF\"\nroot:x:0:0:root:/root:/bin/bash\nbin:x:1:1:bin:/dev/null:/usr/bin/false\ndaemon:x:6:6:Daemon User:/dev/null:/usr/bin/false\nmessagebus:x:18:18:D-Bus Message Daemon User:/run/dbus:/usr/bin/false\nsystemd-journal-gateway:x:73:73:systemd Journal Gateway:/:/usr/bin/false\nsystemd-journal-remote:x:74:74:systemd Journal Remote:/:/usr/bin/false\nsystemd-journal-upload:x:75:75:systemd Journal Upload:/:/usr/bin/false\nsystemd-network:x:76:76:systemd Network Management:/:/usr/bin/false\nsystemd-resolve:x:77:77:systemd Resolver:/:/usr/bin/false\nsystemd-timesync:x:78:78:systemd Time Synchronization:/:/usr/bin/false\nsystemd-coredump:x:79:79:systemd Core Dumper:/:/usr/bin/false\nuuidd:x:80:80:UUID Generation Daemon User:/dev/null:/usr/bin/false\nsystemd-oom:x:81:81:systemd Out Of Memory Daemon:/:/usr/bin/false\nnobody:x:65534:65534:Unprivileged User:/dev/null:/usr/bin/false\nEOF",
    "cat > /etc/group << \"EOF\"\nroot:x:0:\nbin:x:1:daemon\nsys:x:2:\nkmem:x:3:\ntape:x:4:\ntty:x:5:\ndaemon:x:6:\nfloppy:x:7:\ndisk:x:8:\nlp:x:9:\ndialout:x:10:\naudio:x:11:\nvideo:x:12:\nutmp:x:13:\nclock:x:14:\ncdrom:x:15:\nadm:x:16:\nmessagebus:x:18:\nsystemd-journal:x:23:\ninput:x:24:\nmail:x:34:\nkvm:x:61:\nsystemd-journal-gateway:x:73:\nsystemd-journal-remote:x:74:\nsystemd-journal-upload:x:75:\nsystemd-network:x:76:\nsystemd-resolve:x:77:\nsystemd-timesync:x:78:\nsystemd-coredump:x:79:\nuuidd:x:80:\nsystemd-oom:x:81:\nwheel:x:97:\nusers:x:999:\nnogroup:x:65534:\nEOF",
    "echo \"tester:x:101:101::/home/tester:/bin/bash\" >> /etc/passwd\necho \"tester:x:101:\" >> /etc/group\ninstall -o tester -d /home/tester",
    "touch /var/log/{btmp,lastlog,faillog,wtmp}\nchgrp -v utmp /var/log/lastlog\nchmod -v 664  /var/log/lastlog\nchmod -v 600  /var/log/btmp"
  ],
  "cleanup": [
    "rm -rf /usr/share/{info,man,doc}/*",
    "find /usr/{lib,libexec} -name \\*.la -delete",
    "rm -rf /tools"
  ]
}
