{
  "schema_version": 1,
  "package": "cmake",
  "build": "m9-minimal",
  "description": "M9 CMake build using documented bundled copies for recommended libraries absent from the M8 base.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "icewm"
    ],
    "recommended": [],
    "optional": []
  },
  "procedure": [
    {
      "phase": "prepare",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "sed -i '/\"lib64\"/s/64//' Modules/GNUInstallDirs.cmake"
        }
      ]
    },
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./bootstrap --prefix=/usr          \\\n            --system-libs          \\\n            --mandir=/share/man    \\\n            --no-system-jsoncpp    \\\n            --no-system-cppdap     \\\n            --no-system-librhash   \\\n            --no-system-curl       \\\n            --no-system-libarchive \\\n            --no-system-libuv      \\\n            --no-system-nghttp2    \\\n            --docdir=/share/doc/cmake-{version}"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "source",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "bin/ctest -j$(nproc)"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ]
}
