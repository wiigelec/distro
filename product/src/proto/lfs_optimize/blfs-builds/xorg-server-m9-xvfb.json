{
  "schema_version": 1,
  "package": "xorg-server",
  "build": "m9-xvfb",
  "description": "M9 headless X server build for executable IceWM proof without the Mesa/libepoxy Glamor stack.",
  "dependencies": {
    "build": [
      "xorg-libraries",
      "libxcvt",
      "pixman",
      "font-util"
    ],
    "runtime": [
      "xkeyboard-config",
      "systemd"
    ],
    "test": [],
    "before": [
      "icewm"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "gtf",
      "X",
      "Xnest",
      "Xorg",
      "Xvfb"
    ],
    "libraries": [],
    "directories": [
      "/etc/X11/xorg.conf.d",
      "/usr/include/xorg",
      "/usr/lib/xorg",
      "/usr/share/X11/xorg.conf.d"
    ]
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup .. --prefix=/usr --localstatedir=/var -D glamor=false -D secure-rpc=false -D xkb_output_dir=/var/lib/xkb"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "test",
      "working_directory": "build",
      "condition": "tests-enabled",
      "commands": [
        {
          "user": "root",
          "command": "/sbin/ldconfig && ninja test"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install && mkdir -pv /etc/X11/xorg.conf.d"
        }
      ]
    }
  ]
}
