{
  "schema_version": 1,
  "package": "glib",
  "build": "m9-minimal",
  "description": "M9 GLib build without introspection, documentation, sysprof, or tests; sufficient for NetworkManager wired runtime proof.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "networkmanager"
    ],
    "recommended": [],
    "optional": []
  },
  "installed": {
    "programs": [
      "gapplication",
      "gdbus",
      "gdbus-codegen",
      "gio",
      "gio-querymodules",
      "glib-compile-resources",
      "glib-compile-schemas",
      "glib-genmarshal",
      "glib-gettextize",
      "glib-mkenums",
      "gobject-query",
      "gresource",
      "gsettings",
      "gtester",
      "gtester-report"
    ],
    "libraries": [
      "libgio-2.0.so",
      "libglib-2.0.so",
      "libgmodule-2.0.so",
      "libgobject-2.0.so",
      "libgthread-2.0.so"
    ],
    "directories": [
      "/usr/include/glib-2.0",
      "/usr/lib/glib-2.0",
      "/usr/share/glib-2.0"
    ]
  },
  "procedure": [
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "mkdir build && cd build && meson setup .. --prefix=/usr --buildtype=release -D introspection=disabled -D glib_debug=disabled -D man-pages=disabled -D tests=false -D sysprof=disabled"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "build",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "ninja install"
        }
      ]
    }
  ]
}
