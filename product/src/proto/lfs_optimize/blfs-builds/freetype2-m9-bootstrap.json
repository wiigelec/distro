{
  "schema_version": 1,
  "package": "freetype2",
  "build": "m9-bootstrap",
  "description": "M9 bootstrap FreeType build before HarfBuzz exists; follows the documented no-HarfBuzz path.",
  "dependencies": {
    "build": [],
    "runtime": [],
    "test": [],
    "before": [
      "fontconfig"
    ],
    "recommended": [],
    "optional": [
      "libpng",
      "brotli",
      "librsvg"
    ]
  },
  "procedure": [
    {
      "phase": "prepare",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "sed -ri \"s:.*(AUX_MODULES.*valid):\\\\1:\" modules.cfg"
        },
        {
          "user": "root",
          "command": "sed -r \"s:.*(#.*SUBPIXEL_RENDERING) .*:\\\\1:\" -i include/freetype/config/ftoption.h"
        }
      ]
    },
    {
      "phase": "configure",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "./configure --prefix=/usr --disable-static --enable-freetype-config --without-harfbuzz"
        }
      ]
    },
    {
      "phase": "build",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make"
        }
      ]
    },
    {
      "phase": "install",
      "working_directory": "source",
      "condition": "always",
      "commands": [
        {
          "user": "root",
          "command": "make install"
        }
      ]
    }
  ]
}
