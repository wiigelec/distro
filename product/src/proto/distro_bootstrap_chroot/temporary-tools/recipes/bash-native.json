{
  "schema_version": 1,
  "name": "bash",
  "version": "5.3",
  "execution": "native-chroot",
  "source": {
    "url": "https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz",
    "sha256": "0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba"
  },
  "steps": [
    {
      "name": "configure",
      "cwd": "/build/build",
      "argv": [
        "{source}/configure",
        "--prefix=/usr",
        "--without-bash-malloc",
        "--disable-nls"
      ]
    },
    {
      "name": "compile",
      "cwd": "/build/build",
      "argv": [
        "make",
        "-j2"
      ]
    },
    {
      "name": "stage-install",
      "cwd": "/build/build",
      "argv": [
        "make",
        "install",
        "DESTDIR=/build/stage"
      ]
    },
    {
      "name": "verify-staged-bash",
      "cwd": "/build",
      "argv": [
        "/bin/bash",
        "-c",
        "test -x /build/stage/usr/bin/bash"
      ]
    }
  ]
}
