{
  "schema_version": 1,
  "name": "native-binutils",
  "phase": "temp-tools",
  "execution": "host-cross",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--build=x86_64-pc-linux-gnu",
        "--host={target}",
        "--target={target}",
        "--prefix=/usr",
        "--disable-nls",
        "--disable-werror",
        "--disable-gdb",
        "--disable-gprofng",
        "--disable-sim",
        "CC={cc}",
        "CFLAGS=-O2",
        "LDFLAGS={ldflags}"
      ]
    },
    {
      "name": "build",
      "argv": [
        "make",
        "-j{jobs}"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "make",
        "install",
        "DESTDIR=/work/stage"
      ]
    },
    {
      "name": "omit-duplicate-libdep-plugin",
      "argv": [
        "/usr/bin/rm",
        "-f",
        "/work/stage/usr/lib/bfd-plugins/libdep.so"
      ]
    }
  ],
  "native_steps": [
    {
      "name": "configure",
      "argv": ["/work/src/configure", "--prefix=/usr", "--disable-nls", "--disable-werror", "--disable-gdb", "--disable-gprofng", "--disable-sim"]
    },
    {
      "name": "build",
      "argv": ["make", "-j{jobs}", "all-binutils", "all-gas", "all-ld", "MAKEINFO=/usr/bin/true"]
    },
    {
      "name": "stage-install",
      "argv": ["make", "install-binutils", "install-gas", "install-ld", "MAKEINFO=/usr/bin/true", "DESTDIR=/work/stage"]
    }
  ],
  "validation": {
    "chroot_executables": [
      "/usr/bin/as",
      "/usr/bin/ld"
    ]
  },
  "description": "The cross-toolchain root already contains usr/lib/bfd-plugins/libdep.so. Exclude the newly staged copy from native Binutils to avoid replacing the pre-existing plugin; native as/ld remain separate validated binaries. This is a package-scoped exclusion, not a relaxation of install collision checks."
}
