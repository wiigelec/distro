{
  "schema_version": 1,
  "name": "make",
  "phase": "temp-tools",
  "execution": "host-cross",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--build=x86_64-pc-linux-gnu",
        "--host={target}",
        "--prefix=/usr",
        "--disable-nls",
        "CC={cc}",
        "CFLAGS=-O2",
        "LDFLAGS={ldflags}"
      ]
    },
    {
      "name": "build",
      "argv": [
        "make",
        "-j{jobs}"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "make",
        "install",
        "DESTDIR=/work/stage"
      ]
    }
  ],
  "validation": {
    "chroot_executables": [
      "/usr/bin/make"
    ]
  }
}
