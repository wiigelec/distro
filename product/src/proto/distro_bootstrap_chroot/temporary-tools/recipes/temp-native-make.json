{
  "schema_version": 1,
  "name": "make",
  "phase": "temp-tools",
  "execution": "native-root",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/configure",
        "--build={target}",
        "--host={target}",
        "--prefix=/usr",
        "--disable-nls",
        "CC=/usr/bin/gcc",
        "CFLAGS=-O2"
      ]
    },
    {
      "name": "build",
      "argv": [
        "/bin/bash",
        "/work/build/build.sh"
      ]
    },
    {
      "name": "stage-install",
      "argv": [
        "/work/build/make",
        "install",
        "DESTDIR=/work/stage"
      ]
    }
  ],
  "validation": {
    "chroot_executables": [
      "/usr/bin/make"
    ]
  }
}
