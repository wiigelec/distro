{
  "schema_version": 1,
  "phase": "cross-toolchain",
  "status": "prototype",
  "version_policy": "discover-host-each-run-no-locks",
  "target": "x86_64-unknown-linux-gnu",
  "packages": [
    {
      "name": "binutils",
      "state": "executable",
      "host_version": {
        "argv": [
          "ld",
          "--version"
        ],
        "regex": "GNU ld \\(GNU Binutils\\) ([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      },
      "source": {
        "archive_template": "binutils-{version}.tar.xz",
        "url_template": "https://gcc.gnu.org/ftp/binutils/releases/binutils-{version}.tar.xz",
        "sha512_index": "https://gcc.gnu.org/ftp/binutils/releases/sha512.sum"
      },
      "recipe": "recipes/cross-binutils.json"
    },
    {
      "name": "gcc",
      "state": "unresolved-upstream-mapping-and-recipe",
      "host_version": {
        "argv": [
          "gcc",
          "-dumpfullversion"
        ],
        "regex": "^([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
      },
      "source": null,
      "recipe": null
    },
    {
      "name": "linux-api-headers",
      "state": "unresolved-header-version-discovery",
      "host_version": null,
      "source": null,
      "recipe": null
    },
    {
      "name": "glibc",
      "state": "unresolved-upstream-mapping-and-recipe",
      "host_version": {
        "argv": [
          "getconf",
          "GNU_LIBC_VERSION"
        ],
        "regex": "^glibc ([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
      },
      "source": null,
      "recipe": null
    }
  ],
  "note": "Distro's independent package/recipe candidates; only stage progression is modeled after LFS. Host release strings need source mapping validation."
}
