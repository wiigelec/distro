{
  "schema_version": 1,
  "phase": "cross-toolchain",
  "status": "prototype",
  "version_policy": "discover-host-each-run-no-locks",
  "target": "x86_64-unknown-linux-gnu",
  "packages": [
    {
      "name": "binutils",
      "state": "executable",
      "host_version": {
        "argv": [
          "ld",
          "--version"
        ],
        "regex": "GNU ld \\(GNU Binutils\\) ([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      },
      "source": {
        "archive_template": "binutils-{version}.tar.xz",
        "url_template": "https://gcc.gnu.org/ftp/binutils/releases/binutils-{version}.tar.xz",
        "sha512_index": "https://gcc.gnu.org/ftp/binutils/releases/sha512.sum"
      },
      "recipe": "recipes/cross-binutils.json"
    },
    {
      "name": "gcc",
      "state": "executable",
      "host_version": {
        "argv": [
          "gcc",
          "-dumpfullversion"
        ],
        "regex": "^([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
      },
      "upstream_version_policy": "major-minor-zero-release",
      "requires_toolchain_root": true,
      "install_subdir": "toolchain",
      "source": {
        "archive_template": "gcc-{version}.tar.xz",
        "url_template": "https://gcc.gnu.org/pub/gcc/releases/gcc-{version}/gcc-{version}.tar.xz",
        "sha512_index": "https://gcc.gnu.org/pub/gcc/releases/gcc-{version}/sha512.sum"
      },
      "recipe": "recipes/cross-gcc.json"
    },
    {
      "name": "linux-api-headers",
      "state": "executable",
      "host_version": {
        "argv": [
          "pacman",
          "-Q",
          "linux-api-headers"
        ],
        "regex": "^linux-api-headers\\s+([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)(?:-[0-9]+)?$"
      },
      "source": {
        "archive_template": "linux-{version}.tar.xz",
        "url_template": "https://cdn.kernel.org/pub/linux/kernel/v{major}.x/linux-{version}.tar.xz",
        "sha256_index": "https://cdn.kernel.org/pub/linux/kernel/v{major}.x/sha256sums.asc"
      },
      "recipe": "recipes/cross-linux-api-headers.json"
    },
    {
      "name": "glibc",
      "state": "executable",
      "host_version": {
        "argv": [
          "getconf",
          "GNU_LIBC_VERSION"
        ],
        "regex": "^glibc ([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
      },
      "source": {
        "archive_template": "glibc-{version}.tar.xz",
        "url_template": "https://ftp.gnu.org/gnu/glibc/glibc-{version}.tar.xz",
        "signature_url_template": "https://ftp.gnu.org/gnu/glibc/glibc-{version}.tar.xz.sig"
      },
      "recipe": "recipes/cross-glibc.json",
      "requires_toolchain_root": true,
      "install_subdir": "sysroot"
    }
  ],
  "note": "Distro's independent package/recipe candidates; only stage progression is modeled after LFS. Host release strings need source mapping validation."
}
