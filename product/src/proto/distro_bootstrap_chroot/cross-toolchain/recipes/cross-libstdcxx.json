{
  "schema_version": 1,
  "name": "libstdc++",
  "phase": "cross-toolchain",
  "execution": "host-cross",
  "source_package": "gcc",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/gcc-{version}/configure",
        "--target={target}",
        "--prefix=/toolchain/usr",
        "--with-sysroot=/toolchain",
        "--with-native-system-header-dir=/usr/include",
        "--disable-bootstrap",
        "--disable-multilib",
        "--disable-nls",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-libquadmath",
        "--disable-libgomp",
        "--disable-libatomic",
        "--enable-languages=c,c++",
        "--disable-fixincludes"
      ]
    },
    {
      "name": "build-shared-libgcc",
      "argv": [
        "make",
        "-j{jobs}",
        "all-target-libgcc"
      ]
    },
    {
      "name": "stage-shared-libgcc",
      "argv": [
        "make",
        "install-target-libgcc",
        "DESTDIR=/work/prefix"
      ]
    },
    {
      "name": "build-libstdcxx",
      "argv": [
        "make",
        "-j{jobs}",
        "all-target-libstdc++-v3"
      ]
    },
    {
      "name": "stage-libstdcxx",
      "argv": [
        "make",
        "install-target-libstdc++-v3",
        "DESTDIR=/work/prefix"
      ]
    }
  ],
  "validation": {
    "tools": [],
    "glob_tools": [
      "/work/prefix/toolchain/usr/include/c++/*/string",
      "/work/prefix/toolchain/usr/**/libstdc++.so*"
    ],
    "relocatable_output": null
  }
}
