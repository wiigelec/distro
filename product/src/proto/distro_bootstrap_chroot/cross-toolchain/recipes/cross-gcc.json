{
  "schema_version": 1,
  "name": "gcc",
  "phase": "cross-toolchain",
  "status": "experiment",
  "source_directory": "gcc-{version}",
  "build_directory": "build",
  "install_prefix": "/toolchain",
  "steps": [
    {
      "name": "configure",
      "argv": [
        "/work/src/gcc-{version}/configure",
        "--target={target}",
        "--prefix=/toolchain",
        "--with-sysroot=/toolchain/sysroot",
        "--with-as=/toolchain/bin/{target}-as",
        "--with-ld=/toolchain/bin/{target}-ld",
        "--without-headers",
        "--disable-fixincludes",
        "--disable-threads",
        "--disable-shared",
        "--disable-bootstrap",
        "--disable-multilib",
        "--disable-nls",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-libquadmath",
        "--disable-libgomp",
        "--disable-libstdcxx",
        "--enable-languages=c,c++"
      ]
    },
    {
      "name": "build-gcc",
      "argv": [
        "make",
        "-j{jobs}",
        "all-gcc"
      ]
    },
    {
      "name": "build-libgcc",
      "argv": [
        "make",
        "-j{jobs}",
        "all-target-libgcc"
      ]
    },
    {
      "name": "install-gcc",
      "argv": [
        "make",
        "install-gcc",
        "DESTDIR=/work/prefix"
      ]
    },
    {
      "name": "install-libgcc",
      "argv": [
        "make",
        "install-target-libgcc",
        "DESTDIR=/work/prefix"
      ]
    },
    {
      "name": "compiler-version",
      "argv": [
        "/work/prefix/toolchain/bin/{target}-gcc",
        "--version"
      ]
    }
  ],
  "validation": {
    "write_files": {
      "check.c": "int distro_cross_gcc_probe(void) { return 42; }\n"
    },
    "tools": [
      "/work/prefix/toolchain/bin/{target}-gcc",
      "/work/prefix/toolchain/bin/{target}-g++",
      "/work/prefix/toolchain/lib/gcc/{target}/{version}/libgcc.a"
    ],
    "relocatable_output": null
  },
  "description": "Host-following bootstrap cross C/C++ compiler and static target libgcc; no target libc, shared runtime, or libstdc++. GCC and libgcc install into /toolchain, visible only inside the isolated toolchain mount. Compiler and libgcc artifact existence checked; end-to-end target linking remains unproven."
}
