#!/usr/bin/env python3
"""Distro bootstrap phase driver; per-package resumability and live progress."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

HERE = Path(__file__).resolve()
REPO = HERE.parents[2]
PHASES = {
    'cross-toolchain': REPO / 'product/src/proto/distro_bootstrap_chroot/cross-toolchain',
    'temp-tools': REPO / 'product/src/proto/distro_bootstrap_chroot/temporary-tools',
}


def digest(data):
    return hashlib.sha256(data).hexdigest()


def filehash(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for buf in iter(lambda: f.read(1024 * 1024), b''):
            h.update(buf)
    return h.hexdigest()


def say(message):
    print(message, flush=True)


def save(path, record):
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps(record, indent=2, sort_keys=True) + '\n')
    os.replace(temp, path)


def probe(package):
    spec = package['host_version']
    run = subprocess.run(spec['argv'], capture_output=True, text=True,
                         env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}, timeout=30, check=False)
    if run.returncode:
        raise RuntimeError('host version probe failed: ' + package['name'])
    import re
    match = re.search(spec['regex'], run.stdout)
    if not match:
        raise RuntimeError('cannot identify host version: ' + package['name'])
    return match.group(1)


def initialize_merged_usr(root):
    """Create/check the canonical filesystem skeleton before installing packages."""
    links = {'bin': 'usr/bin', 'sbin': 'usr/sbin',
             'lib': 'usr/lib', 'lib64': 'usr/lib64'}
    if not any(root.iterdir()):
        for subdir in ('usr/bin', 'usr/sbin', 'usr/lib', 'usr/lib64', 'usr/include'):
            (root / subdir).mkdir(parents=True, exist_ok=True)
        for name, target in links.items():
            (root / name).symlink_to(target)
    for name, target in links.items():
        link = root / name
        if not link.is_symlink() or os.readlink(link) != target:
            raise RuntimeError('incompatible bootstrap root layout: ' + str(link))
    for name in ('usr/bin', 'usr/sbin', 'usr/lib', 'usr/lib64', 'usr/include'):
        path = root / name
        if not path.is_dir() or path.is_symlink():
            raise RuntimeError('missing or unsafe merged-/usr directory: ' + str(path))


def canonical_install_path(rel):
    """Install legacy top-level paths into /usr, never over root symlinks."""
    parts = rel.parts
    if parts and parts[0] in ('bin', 'sbin', 'lib', 'lib64'):
        return Path('usr', *parts)
    return rel


def copy_prefix(src, root, previous):
    """Preflight every destination before copying, then install without overwrites.

    share/info/dir is a generated GNU Texinfo index, not a package-owned payload.
    A separate indexing step can regenerate it later.
    """
    if previous:
        raise RuntimeError('changed package inputs with installed files: use a clean target root')
    if not src.is_dir() or src.is_symlink():
        raise RuntimeError('missing or invalid staging prefix: ' + str(src))
    entries = []
    for path in sorted(src.rglob('*')):
        rel = path.relative_to(src)
        if rel.as_posix() in ('share/info/dir', 'usr/share/info/dir'):
            continue
        dst = root / canonical_install_path(rel)
        if path.is_dir() and not path.is_symlink():
            kind = 'dir'
        elif path.is_symlink():
            link = os.readlink(path)
            if Path(link).is_absolute():
                raise RuntimeError('unsafe package symlink: ' + str(rel))
            # Walk the target lexically; do not resolve links on the host.
            components = list(rel.parent.parts) if rel.parent != Path('.') else []
            for component in Path(link).parts:
                if component in ('', '.'):
                    continue
                if component == '..':
                    if not components:
                        raise RuntimeError('unsafe package symlink: ' + str(rel))
                    components.pop()
                else:
                    components.append(component)
            # Reject any pre-existing symlink chain leading outside the root.
            target = root.joinpath(*components)
            if not target.resolve(strict=False).is_relative_to(root.resolve()):
                raise RuntimeError('unsafe package symlink target: ' + str(rel))
            kind = 'link'
        elif path.is_file():
            kind = 'file'
        else:
            raise RuntimeError('unsupported staged entry: ' + str(rel))
        # Never follow a pre-existing symlink in any destination parent.
        parent = dst.parent
        while parent != root:
            if parent.is_symlink():
                raise RuntimeError('symlink in destination parent: ' + str(parent))
            parent = parent.parent
        if kind == 'dir':
            if dst.is_symlink() or (dst.exists() and not dst.is_dir()):
                raise RuntimeError('destination directory conflict: ' + str(dst))
        elif dst.exists() or dst.is_symlink():
            raise RuntimeError('destination already exists: ' + str(dst))
        entries.append((path, rel, dst, kind))
    # No filesystem mutation until the entire installation is conflict-free.
    copied = []
    created = []
    try:
        for path, rel, dst, kind in entries:
            if kind == 'dir':
                if not dst.exists():
                    dst.mkdir(parents=True, exist_ok=True)
                    created.append(dst)
            elif kind == 'link':
                for parent in reversed([p for p in dst.parents if p != root and p.is_relative_to(root)]):
                    if not parent.exists():
                        parent.mkdir()
                        created.append(parent)
                link = os.readlink(path)
                dst.symlink_to(link)
                created.append(dst)
                copied.append({'path': str(rel), 'link': link})
            else:
                for parent in reversed([p for p in dst.parents if p != root and p.is_relative_to(root)]):
                    if not parent.exists():
                        parent.mkdir()
                        created.append(parent)
                shutil.copy2(path, dst)
                created.append(dst)
                copied.append({'path': str(rel), 'sha256': filehash(dst)})
    except Exception:
        # Only entries created by this installation are removed; retain existing root files.
        for dst in reversed(created):
            if dst.is_symlink() or dst.is_file():
                dst.unlink()
            elif dst.is_dir():
                dst.rmdir()
        raise
    return copied


def test_installed_cross_compiler(root, state, target):
    """Compile C and C++ with the installed GCC before marking it complete."""
    work = state / 'validation/installed-gcc'
    work.mkdir(parents=True, exist_ok=True)
    probes = [('gcc', 'test.c', 'int distro_probe(void) { return 42; }\n'),
              ('g++', 'test.cc', 'int distro_cxx_probe() { return 42; }\n')]
    cmd = ['bwrap', '--die-with-parent', '--new-session', '--unshare-user',
           '--unshare-pid', '--unshare-net', '--unshare-ipc', '--unshare-uts',
           '--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp', '--dir', '/run',
           '--ro-bind', str(root), '/toolchain', '--bind', str(work), '/work',
           '--clearenv', '--setenv', 'PATH', '/toolchain/usr/bin:/toolchain/bin:/usr/bin:/bin',
           '--setenv', 'LC_ALL', 'C']
    for name in ('usr', 'bin', 'sbin', 'lib', 'lib64', 'etc'):
        if (Path('/') / name).exists():
            cmd += ['--ro-bind', '/' + name, '/' + name]
    cmd.append('--')
    for program, source, code in probes:
        (work / source).write_text(code)
        output = source + '.o'
        compiler = '/toolchain/usr/bin/' + target + '-' + program
        command = cmd + [compiler, '--sysroot=/toolchain', '-c',
                         '/work/' + source, '-o', '/work/' + output]
        run = subprocess.run(command, capture_output=True, text=True, timeout=90, check=False)
        if run.returncode or not (work / output).is_file():
            raise RuntimeError('installed ' + program + ' compile-only test failed: ' + run.stderr[-1500:])
        header = subprocess.run(['readelf', '-h', str(work / output)],
                                capture_output=True, text=True, timeout=30, check=False)
        if header.returncode or 'ELF64' not in header.stdout or 'X86-64' not in header.stdout:
            raise RuntimeError('installed ' + program + ' emitted an invalid target object')
    say('[build] installed GCC C/C++ compile-only smoke tests: PASS')


def good_stamp(stamp, signature, root):
    if not stamp or stamp.get('signature') != signature or stamp.get('status') != 'complete':
        return False
    entries = stamp.get('installed', [])
    if not entries:
        return False
    for item in entries:
        dest = root / item['path']
        if 'sha256' in item and (not dest.is_file() or filehash(dest) != item['sha256']):
            return False
        if 'link' in item and (not dest.is_symlink() or os.readlink(dest) != item['link']):
            return False
    return True


def main():
    ap = argparse.ArgumentParser(description='Build a Distro bootstrap phase into a selected root')
    ap.add_argument('phase', choices=PHASES)
    ap.add_argument('--root', required=True, type=Path)
    ap.add_argument('--cross-compiler', type=Path)
    args = ap.parse_args()
    if os.geteuid() == 0:
        ap.error('run as an ordinary user')
    if args.phase == 'temp-tools':
        if not args.cross_compiler:
            ap.error('temp-tools requires --cross-compiler')
        runner = PHASES['temp-tools'] / 'temp_tools_bootstrap.py'
        status = subprocess.call([sys.executable, str(runner),
                                  str(args.root), str(args.cross_compiler)])
        if status:
            return status
        temp_phase = PHASES['temp-tools']
        temp_manifest = json.loads((temp_phase / 'temporary-tools-manifest.json').read_text())
        if temp_manifest.get('phase') != 'temp-tools' or temp_manifest.get('target') != 'x86_64-distro-linux-gnu':
            raise RuntimeError('temporary-tools manifest identity mismatch')
        for package in temp_manifest['packages']:
            if package['name'] == 'bash' and package.get('state') == 'existing-bootstrap':
                continue
            if package.get('state') != 'executable' or package.get('execution') != 'host-cross':
                raise RuntimeError('unsupported temp-tools package: ' + package['name'])
            if package['name'] != 'coreutils':
                raise RuntimeError('no generic temp-tools package dispatcher for: ' + package['name'])
            helper = temp_phase / 'temp_coreutils_bootstrap.py'
            status = subprocess.call([sys.executable, str(helper), str(args.root)])
            if status:
                return status
        return 0
    if args.cross_compiler:
        ap.error('--cross-compiler is only valid for temp-tools')
    project = args.root.expanduser().resolve()
    if project == Path('/') or project == Path.home().resolve():
        ap.error('unsafe bootstrap project directory')
    # --root names the project directory, not the installed filesystem itself.
    # Build state must never be placed inside the future chroot.
    root = project / 'root'
    state = project / '.distro-bootstrap'
    if root.is_symlink() or state.is_symlink():
        ap.error('root and .distro-bootstrap must be real directories, not symlinks')
    if (root / '.distro-bootstrap').exists() or (root / '.distro-bootstrap').is_symlink():
        ap.error('legacy build state detected inside root/; move it outside root before continuing')
    phase = PHASES[args.phase]
    manifest_path = phase / (args.phase + '-manifest.json')
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('phase') != args.phase:
        ap.error('phase mismatch in manifest')
    project.mkdir(parents=True, exist_ok=True)
    root.mkdir(parents=True, exist_ok=True)
    initialize_merged_usr(root)
    state.mkdir(parents=True, exist_ok=True)
    work = state / 'work' / args.phase
    stamps = state / 'stamps' / args.phase
    work.mkdir(parents=True, exist_ok=True)
    stamps.mkdir(parents=True, exist_ok=True)
    packages = manifest['packages']
    say(f'[build] phase={args.phase} project={project} root={root} state={state} packages={len(packages)}')
    t0 = time.monotonic()
    for n, pkg in enumerate(packages, 1):
        name = pkg['name']
        say(f'[{n}/{len(packages)}] {name}: inspecting manifest')
        if pkg.get('state') != 'executable':
            say(f'[{n}/{len(packages)}] {name}: BLOCKED (recipe or source mapping not ready)')
            return 2
        recipe_path = (phase / pkg['recipe']).resolve()
        if not recipe_path.is_relative_to(phase.resolve()):
            raise RuntimeError('recipe escapes phase directory')
        version = probe(pkg)
        signature = digest(json.dumps({'package': pkg, 'target': manifest['target'],
            'recipe_sha256': filehash(recipe_path), 'version': version,
            'runner_sha256': filehash(phase / 'cross_runner.py')}, sort_keys=True).encode())
        stamp_path = stamps / (name + '.json')
        old = json.loads(stamp_path.read_text()) if stamp_path.exists() else None
        say(f'[{n}/{len(packages)}] {name}: host version {version}')
        if good_stamp(old, signature, root):
            say(f'[{n}/{len(packages)}] {name}: SKIP verified stamp')
            continue
        if old and old.get('installed'):
            say(f'[{n}/{len(packages)}] {name}: BLOCKED changed inputs / installed files; use a clean root')
            return 2
        runid = 1
        while (work / f'{name}-{runid:03d}').exists():
            runid += 1
        workspace = work / f'{name}-{runid:03d}'
        result_path = work / f'{name}-{runid:03d}-result.json'
        runner = phase / 'cross_runner.py'
        argv = [sys.executable, str(runner), '--package', name, '--workspace', str(workspace), '--out', str(result_path)]
        if pkg.get('requires_toolchain_root'):
            argv += ['--toolchain-root', str(root)]
        say(f'[{n}/{len(packages)}] {name}: BUILD started; workspace={workspace}')
        start = time.monotonic()
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        last_step = None
        last_announced = None
        last_report = 0.0
        while p.poll() is None:
            logfile = workspace / 'logs/build.log'
            if logfile.exists():
                with logfile.open(errors='replace') as f:
                    for line in f:
                        if line.startswith('STEP '):
                            last_step = line.strip()[5:]
                if last_step is not None and last_step != last_announced:
                    say(f'[{n}/{len(packages)}] {name}: step={last_step}')
                    last_announced = last_step
            if time.monotonic() - last_report >= 30:
                say(f'[{n}/{len(packages)}] {name}: running ({int(time.monotonic()-start)}s)' + (f' step={last_step}' if last_step else ' acquiring/verifying source'))
                last_report = time.monotonic()
            time.sleep(2)
        stdout, stderr = p.communicate()
        if p.returncode or not result_path.exists():
            say(f'[{n}/{len(packages)}] {name}: FAILED exit={p.returncode} log={workspace / "logs/build.log"} report={result_path}')
            if stderr:
                say(stderr[-1000:])
            return 1
        report = json.loads(result_path.read_text())
        if report.get('status') != 'provisional-pass':
            say(f'[{n}/{len(packages)}] {name}: BLOCKED {report.get("reason", "unknown")} log={workspace / "logs/build.log"}')
            return 1
        say(f'[{n}/{len(packages)}] {name}: BUILD passed ({int(time.monotonic()-start)}s); installing into root')
        installed = copy_prefix(workspace / 'prefix' / pkg.get('install_subdir',''), root, old and old.get('installed'))
        if name == 'gcc':
            test_installed_cross_compiler(root, state, manifest['target'])
        save(stamp_path, {'schema_version': 1, 'status': 'complete', 'package': name,
                          'host_version': version, 'signature': signature,
                          'installed': installed, 'result': str(result_path),
                          'resolved_version': report.get('resolved_version'),
                          'source': report.get('source'),
                          'source_checksum': report.get('source_checksum'),
                          'source_checksum_algorithm': report.get('source_checksum_algorithm')})
        say(f'[{n}/{len(packages)}] {name}: COMPLETE ({len(installed)} installed entries)')
    say(f'[build] validating compiled toolchain and exporting clean root')
    result = subprocess.run([sys.executable, str(phase / 'cross_validate_export.py'),
                             '--root', str(root), '--project', str(project)],
                            check=False)
    if result.returncode:
        raise RuntimeError('cross-toolchain validation/export failed')
    say(f'[build] COMPLETE phase={args.phase} elapsed={int(time.monotonic()-t0)}s')
    return 0

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, KeyError) as e:
        say('[build] ERROR: ' + str(e))
        raise SystemExit(1)
