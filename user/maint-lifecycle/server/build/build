#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import tarfile
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
SERVER = HERE.parent
PUBLISH = SERVER / "publish"
MANIFEST = HERE / "manifest.json"
STATE = HERE / "state.json"
PACKAGES = HERE / "packages"
SOURCES = HERE / "sources"
WORK = HERE / "work"
STAGE = HERE / "stage"
CANDIDATES = HERE / "candidates"
ARCH = "x86_64"
UA = "distro-maint-lifecycle-prototype/1"


def load(path, default):
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else default


def save(path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def emit(obj):
    print(json.dumps(obj, indent=2, sort_keys=True))


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def version_key(version):
    # tree-specific discovery ordering; not distro-wide version semantics.
    return tuple(int(part) for part in version.split("."))


def package_entry(name):
    manifest = load(MANIFEST, {"schema_version": 1, "packages": {}})
    try:
        return manifest["packages"][name]
    except KeyError:
        raise RuntimeError(f"not tracked: {name}")


def version_dir(name, version):
    return PACKAGES / name / version


def recipe_path(name, version, kind):
    return version_dir(name, version) / f"recipe-{kind}.json"


def cmd_track(args):
    manifest = load(MANIFEST, {"schema_version": 1, "packages": {}})
    previous = manifest["packages"].get(args.name)
    manifest["packages"][args.name] = {
        "repository": args.repository,
        "automation": "assisted",
        "discovery": "github-tags",
    }
    save(MANIFEST, manifest)
    emit({"operation": "track", "package": args.name, "previous": previous,
          "tracked": manifest["packages"][args.name], "manifest": str(MANIFEST)})


def github_tags(repository):
    match = re.match(r"https://github\.com/([^/]+)/([^/]+?)(?:\.git)?$", repository)
    if not match:
        raise RuntimeError("prototype discovery currently expects a github.com repository URL")
    owner, name = match.groups()
    request = urllib.request.Request(
        f"https://api.github.com/repos/{owner}/{name}/tags?per_page=100",
        headers={"User-Agent": UA, "Accept": "application/vnd.github+json"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return [row["name"] for row in json.load(response)]


def cmd_discover(args):
    package = package_entry(args.name)
    if args.tags_file:
        tags = load(Path(args.tags_file), [])
        source = f"fixture:{args.tags_file}"
    else:
        tags = github_tags(package["repository"])
        source = package["repository"]

    stable = [tag for tag in tags if re.fullmatch(r"\d+(?:\.\d+)+", tag)]
    if args.max_version:
        ceiling = version_key(args.max_version)
        stable = [tag for tag in stable if version_key(tag) <= ceiling]
    if not stable:
        raise RuntimeError("no acceptable stable tags discovered")

    stable = sorted(set(stable), key=version_key)
    latest = stable[-1]
    state = load(STATE, {"schema_version": 1, "packages": {}})
    package_state = state["packages"].setdefault(args.name, {})
    previous = package_state.get("latest_observed")
    accepted = package_state.get("accepted_version")
    package_state["observed_versions"] = sorted(
        set(package_state.get("observed_versions", [])) | set(stable), key=version_key
    )
    package_state["latest_observed"] = latest
    package_state["last_discovery_source"] = source
    save(STATE, state)
    result = "new-version-observed" if accepted and latest != accepted else (
        "initial-version-observed" if not accepted else "accepted-version-current"
    )
    emit({"operation": "discover", "package": args.name, "previous_latest": previous,
          "accepted_version": accepted, "observed_versions": stable,
          "latest_observed": latest, "result": result, "state": str(STATE)})


def cmd_accept(args):
    package_entry(args.name)
    state = load(STATE, {"schema_version": 1, "packages": {}})
    package_state = state["packages"].setdefault(args.name, {})
    if args.version not in package_state.get("observed_versions", []):
        raise RuntimeError(f"{args.version} has not been observed")
    previous = package_state.get("accepted_version")
    registry = package_state.get("version_registry", [])
    if args.version not in registry:
        registry.append(args.version)
        registry.sort(key=version_key)
    package_state["version_registry"] = registry
    package_state["accepted_version"] = args.version
    save(STATE, state)
    emit({"operation": "accept", "package": args.name, "previous_accepted": previous,
          "accepted_version": args.version, "version_registry": registry,
          "revision": "r1", "state": str(STATE)})


def discovered_tree_recipe(name, version, repository):
    repo = repository.rstrip("/")
    return {
        "schema_version": 1,
        "identity": {"name": name, "version": version, "architecture": ARCH, "revision": "r1"},
        "source": {"url": f"{repo}/archive/refs/tags/{version}.tar.gz"},
        "build": {"commands": [
            "make",
            'make DESTDIR="$DESTDIR" PREFIX=/usr MANDIR=/usr/share/man install',
        ]},
        "runtime": {"depends": [], "conflicts": [], "provides": []},
        "validation": {"required_owned_paths": ["usr/bin/tree", "usr/share/man/man1/tree.1"]},
    }


def cmd_recipe_discover(args):
    package = package_entry(args.name)
    state = load(STATE, {"packages": {}})
    package_state = state["packages"].get(args.name, {})
    if package_state.get("accepted_version") != args.version:
        raise RuntimeError("version must be accepted before recipe discovery")
    if args.name != "tree":
        raise RuntimeError("prototype recipe discovery currently implements tree only")
    recipe = discovered_tree_recipe(args.name, args.version, package["repository"])
    path = recipe_path(args.name, args.version, "discovery")
    save(path, recipe)
    emit({"operation": "recipe-discover", "package": args.name, "version": args.version,
          "recipe": str(path), "source": recipe["source"],
          "commands": recipe["build"]["commands"]})


def safe_extract(tf, destination):
    root = destination.resolve()
    for member in tf.getmembers():
        target = (destination / member.name).resolve()
        if root not in target.parents and target != root:
            raise RuntimeError("unsafe archive member")
    tf.extractall(destination, filter="data")


def acquire_source(args, recipe):
    source = SOURCES / f"{args.name}-{args.version}.tar.gz"
    source.parent.mkdir(parents=True, exist_ok=True)
    transport = "cache"
    if args.source_archive:
        shutil.copy2(args.source_archive, source)
        transport = f"provided:{args.source_archive}"
    elif not source.exists():
        request = urllib.request.Request(recipe["source"]["url"], headers={"User-Agent": UA})
        with urllib.request.urlopen(request, timeout=60) as response, source.open("wb") as out:
            shutil.copyfileobj(response, out)
        transport = "download"
    return source, transport


def execute_recipe(args, kind, produce_candidate=False):
    path = recipe_path(args.name, args.version, kind)
    if not path.exists():
        raise RuntimeError(f"{kind} recipe does not exist: {path}")
    recipe = load(path, {})
    source, transport = acquire_source(args, recipe)
    label = f"{args.name}-{args.version}-{kind}"
    work = WORK / label
    stage = STAGE / label
    shutil.rmtree(work, ignore_errors=True)
    shutil.rmtree(stage, ignore_errors=True)
    work.mkdir(parents=True)
    stage.mkdir(parents=True)
    with tarfile.open(source, "r:*") as tf:
        safe_extract(tf, work)
    roots = [item for item in work.iterdir() if item.is_dir()]
    src = roots[0] if len(roots) == 1 else work
    env = os.environ.copy()
    env["DESTDIR"] = str(stage)
    log = []
    for command in recipe["build"]["commands"]:
        cp = subprocess.run(command, shell=True, cwd=src, env=env, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        log.append({"command": command, "returncode": cp.returncode, "output": cp.stdout})
        if cp.returncode:
            log_path = WORK / f"{label}.build-log.json"
            save(log_path, log)
            return {"status": "failure", "recipe_kind": kind, "recipe": str(path),
                    "failed_command": command, "build_log": str(log_path),
                    "source_transport": transport, "source_sha256": sha256(source)}
    owned = [item.relative_to(stage).as_posix() for item in sorted(stage.rglob("*"))
             if item.is_file() or item.is_symlink()]
    required = recipe.get("validation", {}).get("required_owned_paths", [])
    missing = [path for path in required if path not in owned]
    if missing:
        log_path = WORK / f"{label}.build-log.json"
        save(log_path, log)
        return {"status": "failure", "recipe_kind": kind, "recipe": str(path),
                "failure": "staging-validation-failed", "missing_owned_paths": missing,
                "owned_paths": owned, "build_log": str(log_path),
                "source_transport": transport, "source_sha256": sha256(source)}
    result = {"status": "success", "recipe_kind": kind, "recipe": str(path),
              "source_transport": transport, "source_sha256": sha256(source),
              "owned_paths": owned, "build_log": log}
    if not produce_candidate:
        return result
    metadata = {"schema_version": 1, "identity": recipe["identity"],
                "depends": recipe["runtime"]["depends"],
                "conflicts": recipe["runtime"]["conflicts"],
                "provides": recipe["runtime"]["provides"], "owned_paths": owned}
    CANDIDATES.mkdir(parents=True, exist_ok=True)
    artifact = CANDIDATES / f"{args.name}-{args.version}-{ARCH}-r1.distro.tar.gz"
    encoded = (json.dumps(metadata, indent=2, sort_keys=True) + "\n").encode()
    with tarfile.open(artifact, "w:gz") as tf:
        info = tarfile.TarInfo("metadata.json")
        info.size = len(encoded)
        info.mode = 0o644
        tf.addfile(info, io.BytesIO(encoded))
        for item in sorted(stage.rglob("*")):
            tf.add(item, arcname="root/" + item.relative_to(stage).as_posix(), recursive=False)
    result["artifact"] = str(artifact)
    result["artifact_sha256"] = sha256(artifact)
    save(CANDIDATES / f"{args.name}-{args.version}.result.json", result)
    return result


def previous_working_recipe(name, version):
    package_root = PACKAGES / name
    if not package_root.exists():
        return None
    found = []
    for child in package_root.iterdir():
        working = child / "recipe-working.json"
        if not child.is_dir() or not working.exists() or child.name == version:
            continue
        try:
            key = version_key(child.name)
        except ValueError:
            continue
        if key < version_key(version):
            found.append((key, working))
    return max(found, default=(None, None))[1]


def cmd_test_discovery(args):
    result = execute_recipe(args, "discovery")
    if result["status"] == "success":
        working = recipe_path(args.name, args.version, "working")
        shutil.copy2(recipe_path(args.name, args.version, "discovery"), working)
        result.update({"operation": "test-discovery", "result": "discovery-working",
                       "working_recipe": str(working)})
        emit(result)
        return
    working = recipe_path(args.name, args.version, "working")
    prior = previous_working_recipe(args.name, args.version)
    if working.exists():
        outcome = "working-recipe-available"
    elif prior:
        outcome = "previous-working-recipe-available"
    else:
        outcome = "needs-manual-intervention"
    result.update({"operation": "test-discovery", "result": outcome,
                   "working_recipe": str(working) if working.exists() else None,
                   "previous_working_recipe": str(prior) if prior else None})
    emit(result)
    raise SystemExit(1)


def cmd_working_init(args):
    discovery = recipe_path(args.name, args.version, "discovery")
    working = recipe_path(args.name, args.version, "working")
    if not discovery.exists():
        raise RuntimeError("recipe discovery must run before working-init")
    if working.exists() and not args.force:
        raise RuntimeError(f"working recipe already exists: {working}")

    prior = previous_working_recipe(args.name, args.version)
    discovery_recipe = load(discovery, {})
    if prior:
        working_recipe = load(prior, {})
        working_recipe["identity"] = discovery_recipe["identity"]
        working_recipe["source"] = discovery_recipe["source"]
        working_recipe["validation"] = discovery_recipe.get(
            "validation", working_recipe.get("validation", {})
        )
        source = prior
        result = "previous-working-adapted"
    else:
        working_recipe = discovery_recipe
        source = discovery
        result = "manual-edit-required"

    save(working, working_recipe)
    emit({"operation": "working-init", "package": args.name, "version": args.version,
          "source": str(source), "working_recipe": str(working), "result": result})


def cmd_test_working(args):
    result = execute_recipe(args, "working")
    result["operation"] = "test-working"
    result["result"] = "working-recipe-passes" if result["status"] == "success" else "needs-manual-intervention"
    emit(result)
    if result["status"] != "success":
        raise SystemExit(1)


def cmd_build(args):
    if not recipe_path(args.name, args.version, "working").exists():
        raise RuntimeError("working recipe required before build")
    result = execute_recipe(args, "working", produce_candidate=True)
    result["operation"] = "build"
    emit(result)
    if result["status"] != "success":
        raise SystemExit(1)


def cmd_publish(args):
    state = load(STATE, {"packages": {}})
    package_state = state["packages"].get(args.name, {})
    if package_state.get("accepted_version") != args.version:
        raise RuntimeError("version must be accepted before publication")
    artifact = CANDIDATES / f"{args.name}-{args.version}-{ARCH}-r1.distro.tar.gz"
    result_path = CANDIDATES / f"{args.name}-{args.version}.result.json"
    if not artifact.exists() or not result_path.exists():
        raise RuntimeError("build must run before publish")
    built = load(result_path, {})
    PUBLISH.mkdir(parents=True, exist_ok=True)
    (PUBLISH / "artifacts").mkdir(exist_ok=True)
    destination = PUBLISH / "artifacts" / artifact.name
    shutil.copy2(artifact, destination)
    db = load(PUBLISH / "package-db.json", {"schema_version": 1, "generation": 0,
              "requirements": {}, "catalogs": {ARCH: {"packages": {}}}})
    db["generation"] += 1
    requirement = db["requirements"].setdefault(args.name, {"kind": "package", "versions": []})
    for version in package_state.get("version_registry", []):
        if version not in requirement["versions"]:
            requirement["versions"].append(version)
    requirement["versions"].sort(key=version_key)
    package = db["catalogs"].setdefault(ARCH, {"packages": {}})["packages"].setdefault(
        args.name, {"current": None, "available": []})
    entry = {"version": args.version, "revision": "r1",
             "artifact_reference": "artifacts/" + destination.name,
             "artifact_checksum": sha256(destination),
             "metadata": {"depends": [], "conflicts": [], "provides": [],
                          "owned_paths": built["owned_paths"]}}
    package["available"] = [item for item in package["available"] if item["version"] != args.version] + [entry]
    package["available"].sort(key=lambda item: version_key(item["version"]))
    package["current"] = {"version": args.version, "revision": "r1"}
    save(PUBLISH / "package-db.json", db)
    emit({"operation": "publish", "package": args.name, "version": args.version,
          "generation": db["generation"], "current": package["current"],
          "available": [item["version"] + "-" + item["revision"] for item in package["available"]],
          "package_database": str(PUBLISH / "package-db.json"), "artifact": str(destination)})


def cmd_status(args):
    state = load(STATE, {"packages": {}})
    recipe_state = None
    if args.version:
        discovery = recipe_path(args.name, args.version, "discovery")
        working = recipe_path(args.name, args.version, "working")
        recipe_state = {"discovery_recipe": str(discovery) if discovery.exists() else None,
                        "working_recipe": str(working) if working.exists() else None,
                        "manual_intervention": discovery.exists() and working.exists()
                        and discovery.read_bytes() != working.read_bytes()}
    emit({"operation": "status", "package": args.name,
          "state": state.get("packages", {}).get(args.name), "recipe_state": recipe_state})


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("track"); p.add_argument("name"); p.add_argument("repository"); p.set_defaults(fn=cmd_track)
    p = sub.add_parser("discover"); p.add_argument("name"); p.add_argument("--max-version"); p.add_argument("--tags-file"); p.set_defaults(fn=cmd_discover)
    p = sub.add_parser("accept"); p.add_argument("name"); p.add_argument("version"); p.set_defaults(fn=cmd_accept)
    p = sub.add_parser("recipe-discover"); p.add_argument("name"); p.add_argument("version"); p.set_defaults(fn=cmd_recipe_discover)
    for name, fn in (("test-discovery", cmd_test_discovery), ("test-working", cmd_test_working), ("build", cmd_build)):
        p = sub.add_parser(name); p.add_argument("name"); p.add_argument("version"); p.add_argument("--source-archive", type=Path); p.set_defaults(fn=fn)
    p = sub.add_parser("working-init"); p.add_argument("name"); p.add_argument("version"); p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_working_init)
    p = sub.add_parser("publish"); p.add_argument("name"); p.add_argument("version"); p.set_defaults(fn=cmd_publish)
    p = sub.add_parser("status"); p.add_argument("name"); p.add_argument("version", nargs="?"); p.set_defaults(fn=cmd_status)
    args = parser.parse_args()
    try:
        args.fn(args)
    except RuntimeError as exc:
        emit({"operation": args.cmd, "status": "error", "error": str(exc)})
        raise SystemExit(1)


if __name__ == "__main__":
    main()
