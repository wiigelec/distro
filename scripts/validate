#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def run_validation(path: Path) -> int:
    if not path.is_file():
        print(f"Validation entry point missing: {path.relative_to(ROOT)}", file=sys.stderr)
        return 1
    if not os.access(path, os.X_OK):
        print(f"Validation entry point is not executable: {path.relative_to(ROOT)}", file=sys.stderr)
        return 1
    return subprocess.call([str(path)], cwd=ROOT)


def main() -> int:
    framework = ROOT / "repo" / "scripts" / "validate"
    result = run_validation(framework)
    if result != 0:
        return result

    product_root = ROOT / "product"
    product = product_root / "scripts" / "validate"
    if product_root.exists():
        return run_validation(product)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
